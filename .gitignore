# Build output. Every generated tree is reproducible from the graphs.
build/
node_modules/

# The browser demo as the Pages workflow builds it (node packages/demo/build.ts demo).
/demo/

# ...except the build pipeline's own source, which shares the name.
!packages/core/src/build/

# Preserved regions that lost their home during a regenerate. Review, then delete.
*.orphaned

# Language toolchain leavings inside example projects.
__pycache__/
*.pyc
target/
bin/
obj/
sources.txt

# Launcher build output. Rebuild with launcher\build.ps1
dist/
launcher/bin/
launcher/obj/
MasterCode.exe

# Deployment secrets; only .env.example is committed
.env

# Projects made with Master Code belong in their own repos
projects/
tools/draken/
tools/soar/
