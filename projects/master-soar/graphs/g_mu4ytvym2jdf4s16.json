        "capabilities": [],
        "code": "code = int(status)\nif code == 429:\n    return \"RATE_LIMITED\"\nif code in (401, 403):\n    return \"AUTH\"\nif code == 404:\n    return \"NOT_FOUND\"\nif code in (408, 425, 502, 503, 504):\n    return \"TRANSIENT\"\nif 400 <= code < 500:\n    return \"VALIDATION\"\nif code >= 500:\n    return \"TRANSIENT\"\nreturn \"PERMANENT\"",
