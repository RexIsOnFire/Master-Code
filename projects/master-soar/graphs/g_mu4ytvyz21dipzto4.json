      "props": {
        "capabilities": [],
        "code": "const table = byName(name);\nif (!table) return;\nconst body = table.tBodies[0] || table.createTBody();\nbody.replaceChildren();\nfor (const row of rows || []) {\n  const tr = body.insertRow();\n  for (const column of columns) {\n    const cell = tr.insertCell();\n    const value = row[column.field];\n    if (column.className) cell.className = typeof column.className === \"function\"\n      ? column.className(row) : column.className;\n    cell.textContent = value === null || value === undefined ? \"—\" : String(value);\n  }\n}",
        "doc": "Build a table from data, cell by cell, with textContent. Typed construction rather than string concatenation - the same reason, in the place it matters most.",
        "form": "statements",
        "language": "javascript",
        "name": "render_table_rows",
        "packages": [],
