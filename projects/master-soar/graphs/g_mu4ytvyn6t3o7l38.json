        "code": "lease = {}\nfor entry in auth_spec or []:\n    role = entry.get(\"role\")\n    name = entry.get(\"credential\")\n    if not role or not name:\n        raise ValueError(\"auth entry needs both a role and a credential name\")\n    lease[role] = provider.resolve(org_id, name)\nreturn lease",
