      "props": {
        "capabilities": [
          "net"
        ],
        "code": "import httpx\n\nif self.kind == \"azure_openai\":\n    url = (\"%s/openai/deployments/%s/chat/completions?api-version=2024-06-01\"\n           % (self.base_url.rstrip(\"/\"), self.model))\n    headers = {\"api-key\": self.credential.reveal()}\nelse:\n    url = self.base_url.rstrip(\"/\") + \"/v1/chat/completions\"\n    headers = {\"Authorization\": \"Bearer \" + self.credential.reveal()}\n\nbody = {\n    \"model\": self.model,\n    \"messages\": messages,\n    \"temperature\": options.get(\"temperature\", 0.1),\n    \"max_tokens\": options.get(\"max_tokens\", 2048),\n}\nif tools:\n    body[\"tools\"] = [{\"type\": \"function\", \"function\": t} for t in tools]\n\nwith httpx.Client(timeout=options.get(\"timeout_s\", 120)) as client:\n    response = client.post(url, headers=headers, json=body)\n    if response.status_code >= 400:\n        raise RuntimeError(\"%s returned %d: %s\"\n                           % (self.kind, response.status_code,\n                              response.text[:500]))\n    payload = response.json()\n\nchoice = (payload.get(\"choices\") or [{}])[0]\nmessage = choice.get(\"message\", {})\nusage = payload.get(\"usage\", {})\nreturn {\n    \"text\": message.get(\"content\") or \"\",\n    \"tool_calls\": [\n        {\"name\": call[\"function\"][\"name\"],\n         \"arguments\": call[\"function\"].get(\"arguments\", \"{}\")}\n        for call in message.get(\"tool_calls\", [])\n    ],\n    \"tokens_in\": usage.get(\"prompt_tokens\", 0),\n    \"tokens_out\": usage.get(\"completion_tokens\", 0),\n    \"finish_reason\": choice.get(\"finish_reason\", \"stop\"),\n    \"model\": payload.get(\"model\", self.model),\n}",
        "doc": "One turn, normalised into the platform response shape.",
        "form": "statements",
        "language": "python",
