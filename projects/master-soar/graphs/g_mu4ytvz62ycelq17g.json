      "props": {
        "capabilities": [],
        "code": "from soar.commands.http_command import check_destination\n\nHOSTILE = [\n    \"http://169.254.169.254/latest/meta-data/\",\n    \"http://[fd00:ec2::254]/\",\n    \"http://127.0.0.1:5432/\",\n    \"http://localhost/admin\",\n    \"http://10.0.0.5/\",\n    \"http://192.168.1.1/\",\n    \"http://172.16.0.1/\",\n    \"file:///etc/passwd\",\n    \"gopher://internal/\",\n]\nfor url in HOSTILE:\n    try:\n        check_destination(url, [])\n    except (PermissionError, ValueError):\n        continue\n    return False  # a hostile destination was accepted\nreturn True",
        "doc": "Drive check_destination over every destination that must be refused, and return true only if all of them were.",
        "form": "statements",
        "language": "python",
        "name": "exercise_ssrf_guard",
        "packages": [],
        "params": [],
        "returns": "bool"
      },
      "type": "custom/code",
