      "props": {
        "capabilities": [],
        "code": "body = str(content or \"\")\nbody = body.replace(\"END EVIDENCE\", \"END_EVIDENCE\").replace(\n    \"BEGIN EVIDENCE\", \"BEGIN_EVIDENCE\"\n)\nif len(body) > 65536:\n    body = body[:65536] + \"\\n[truncated]\"\nreturn \"\\n\".join([\n    \"BEGIN EVIDENCE\",\n    \"source: %s %s\" % (source_kind, source_id),\n    \"field: %s\" % field,\n    \"trust: untrusted\",\n    \"---\",\n    body,\n    \"END EVIDENCE\",\n])",
        "doc": "Deliver untrusted content in the data channel, labelled with its provenance.\n\nDelimiters inside the content are neutralised, because an attacker who can\nwrite \"END EVIDENCE\" into an alert description would otherwise be writing\nin the instruction channel.",
