          "type": "List<Map<string, Any>>"
        }
      ],
      "props": {
        "capabilities": [],
        "code": "import re\n\nSIGNALS = [\n    (r\"ignore (all |your |previous |prior )*(instructions|rules|prompt)\",\n     \"instruction-override\"),\n    (r\"(you are|act as|pretend to be) (now )?an?\\b\", \"role-reassignment\"),\n    (r\"(system|developer) (prompt|message|instruction)\", \"channel-confusion\"),\n    (r\"disregard (the |any )?(above|previous|prior|earlier)\", \"instruction-override\"),\n    (r\"\\b(isolate|block|disable|delete|purge) (every|all)\\b\", \"mass-action-request\"),\n    (r\"do not (tell|report|alert|notify|log)\", \"suppression-request\"),\n    (r\"(mark|classify|treat) (this|it) as (benign|safe|false positive)\",\n     \"verdict-steering\"),\n    (r\"</?(system|assistant|user|tool)>\", \"tag-injection\"),\n    (r\"END EVIDENCE|BEGIN EVIDENCE\", \"delimiter-injection\"),\n]\n\ntext = str(content or \"\")\nfindings = []\nfor pattern, label in SIGNALS:\n    match = re.search(pattern, text, re.IGNORECASE)\n    if match:\n        findings.append({\n            \"signal\": label,\n            \"excerpt\": text[max(0, match.start() - 40):match.end() + 40],\n            \"note\": \"shown to the analyst; does not change what the model may do\",\n        })\nreturn findings",
        "doc": "Flag text that is trying to address the assistant.\n\nThis does not block anything and is not the defence - channel separation and\nthe pre-computed tool set are. It annotates the turn so the analyst sees\nthat the alert contained an injection attempt, which is a detection in its\nown right.",
