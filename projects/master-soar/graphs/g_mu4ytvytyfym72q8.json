      "props": {
        "capabilities": [],
        "code": "commands = []\nfor pack in shipped_connectors():\n    for command in pack[\"commands\"]:\n        entry = dict(command)\n        entry[\"connector_id\"] = pack[\"id\"]\n        entry[\"connector_name\"] = pack[\"name\"]\n        entry[\"vendor\"] = pack[\"vendor\"]\n        entry[\"connector_category\"] = pack[\"category\"]\n        commands.append(entry)\nreturn commands",
        "doc": "Every prebuilt command, flattened, each carrying the connector it came from. This is what the playbook editor palette is built from.",
        "form": "statements",
