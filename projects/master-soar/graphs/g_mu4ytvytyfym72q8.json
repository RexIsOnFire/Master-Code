        "capabilities": [],
        "code": "packs = shipped_connectors()\ncommands = all_commands()\nby_category = {}\nfor pack in packs:\n    by_category.setdefault(pack[\"category\"], []).append(pack[\"name\"])\nreturn {\n    \"connectors\": len(packs),\n    \"commands\": len(commands),\n    \"mutating\": sum(1 for c in commands if c[\"effect\"] == \"mutating\"),\n    \"high_risk\": sum(1 for c in commands if c[\"risk_level\"] == \"high\"),\n    \"by_category\": by_category,\n}",
