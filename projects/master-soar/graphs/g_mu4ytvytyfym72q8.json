      "props": {
        "capabilities": [],
        "code": "from soar.integrations.catalog_edr import edr_connectors\nfrom soar.integrations.catalog_email import email_connectors\nfrom soar.integrations.catalog_identity import identity_connectors\nfrom soar.integrations.catalog_intel import intel_connectors\nfrom soar.integrations.catalog_itsm import itsm_connectors\nfrom soar.integrations.catalog_network import network_connectors\nfrom soar.integrations.catalog_siem import siem_connectors\n\nreturn (\n    edr_connectors()\n    + siem_connectors()\n    + identity_connectors()\n    + email_connectors()\n    + network_connectors()\n    + itsm_connectors()\n    + intel_connectors()\n)",
