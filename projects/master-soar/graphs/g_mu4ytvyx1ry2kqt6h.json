      "props": {
        "capabilities": [],
        "code": "from soar.integrations.catalog_edr import resolve_containment\nfrom soar.platform.runtime import log_event, services\n\nrows = db.query(\n    \"SELECT s.id, s.node_id, s.attempt, s.node_kind, s.input, \"\n    \"pv.definition, e.incident_id \"\n    \"FROM execution_step s JOIN execution e ON e.id = s.execution_id \"\n    \"JOIN playbook_version pv ON pv.id = e.playbook_version_id \"\n    \"WHERE s.id = %s AND s.org_id = %s\", [step_id, org_id], org_id,\n)\nif not rows:\n    raise KeyError(\"no such step\")\nstep = rows[0]\n\nnode_id = step[\"node_id\"].split(\"/\")[-1]\nnode = step[\"definition\"][\"nodes\"].get(node_id, {})\n\ncommand_key = node.get(\"command\")\nif node.get(\"kind\") == \"response\":\n    # An abstract action resolves to a vendor command HERE, against the EDR\n    # that actually has an agent on this host. The resolution and its\n    # semantics go on the step, so the timeline records what this particular\n    # EDR meant by the word.\n    target = (step[\"input\"] or {}).get(\"target\")\n    resolved = resolve_containment(db, org_id, node[\"action\"], target)\n    command_key = resolved[\"command\"]\n    db.execute(\n        \"UPDATE execution_step SET logs = %s WHERE id = %s\",\n        [json_dumps_compat({\"resolved\": resolved}), step_id], org_id,\n    )\n\nversion_id = None\nif command_key:\n    # This client's own commands, plus every command shared with it. A\n    # shared command is one row seen from several places, never a copy.\n    found = db.query(\n        \"SELECT cv.id FROM command c \"\n        \"JOIN command_version cv ON cv.id = c.current_version_id \"\n        \"LEFT JOIN command_visibility v ON v.command_id = c.id \"\n        \"  AND v.org_id = %s \"\n        \"WHERE c.key = %s AND NOT c.deprecated AND (\"\n        \"  c.org_id = %s OR c.org_id IS NULL OR v.org_id IS NOT NULL)\",\n        [org_id, command_key, org_id], org_id,\n    )\n    if not found:\n        raise KeyError(\"command %r is not published here\" % command_key)\n    version_id = found[0][\"id\"]\n\njob = {\n    \"org_id\": org_id,\n    \"execution_id\": execution_id,\n    \"step_id\": step_id,\n    \"command_version_id\": version_id,\n    \"inputs\": step[\"input\"] or {},\n    \"mode\": mode,\n    \"incident_id\": step[\"incident_id\"],\n    \"idempotency_key\": \"%s:%s:%d\" % (execution_id, step[\"node_id\"], step[\"attempt\"]),\n}\n\nqueue = services()[\"queue\"]\njob_id = queue.publish(\"jobs:\" + pool, job)\ndb.execute(\"UPDATE execution_step SET job_id = %s WHERE id = %s\",\n           [job_id, step_id], org_id)\nlog_event(\"info\", \"step_enqueued\",\n          {\"execution_id\": execution_id, \"step_id\": step_id, \"pool\": pool})\nreturn job_id",
        "doc": "Put one step on a worker queue.\n\nThe job carries ids and an idempotency key, never code and never a callable.\nCredentials are NOT in it at enqueue time - the worker leases them itself,\nafter it has won the claim, so a job sitting in a queue is not a credential\nsitting in a queue.",
