        "code": "from soar.platform.ids import new_id\nfrom soar.platform.runtime import log_event\n\nSEVERITY = {\n    \"audit_chain_broken\": \"critical\",\n    \"secret_shape_in_output\": \"critical\",\n    \"execution_failed\": \"high\",\n    \"compensations_run\": \"high\",\n    \"worker_down\": \"high\",\n    \"integration_failing\": \"medium\",\n    \"queue_depth\": \"medium\",\n    \"loop_truncated\": \"medium\",\n    \"credential_expiring\": \"low\",\n}\n\npayload = json_dumps_compat(detail)\nexisting = db.query(\n    \"SELECT id FROM platform_alert WHERE org_id = %s AND kind = %s \"\n    \"AND cleared_at IS NULL AND detail = %s::jsonb LIMIT 1\",\n    [org_id, kind, payload], org_id,\n)\nif existing:\n    return existing[0][\"id\"]\n\nalert_id = new_id(\"palert\")\ndb.execute(\n    \"INSERT INTO platform_alert (id, org_id, kind, severity, detail) \"\n    \"VALUES (%s, %s, %s, %s, %s)\",\n    [alert_id, org_id, kind, SEVERITY.get(kind, \"medium\"), payload], org_id,\n)\nlog_event(\"warning\", \"platform_alert\", {\"kind\": kind, \"detail\": detail})\nreturn alert_id",
