          "direction": "out",
          "id": "result",
          "name": "result",
          "type": "Map<string, Any>"
        }
      ],
      "props": {
        "capabilities": [
          "env"
        ],
        "code": "import os\n\nsettings = default_settings()\nfor key in list(settings.keys()):\n    env_name = \"SOAR_\" + key.upper()\n    if env_name in os.environ:\n        settings[key] = os.environ[env_name]\n\n# A missing root key is a refusal to start, never a generated default at\n# run time. The key is created once, by first boot, with mode 0600.\nsettings[\"root_key_path\"] = os.environ.get(\"SOAR_ROOT_KEY_PATH\", \"/data/keys/root.key\")\nsettings[\"root_key_inline\"] = os.environ.get(\"SOAR_ROOT_KEY\", \"\")\nreturn settings",
        "doc": "Defaults, overlaid by SOAR_* environment variables. Nothing else is consulted.",
        "form": "statements",
        "language": "python",
        "name": "read_environment_overrides",
        "packages": [],
        "params": [],
        "returns": "Map<string, Any>"
      },
