        "code": "key = \"rl:\" + bucket\npipe = redis.pipeline()\npipe.incr(key)\npipe.ttl(key)\ncount, ttl = pipe.execute()\nif ttl < 0:\n    redis.expire(key, int(window_s))\n    ttl = int(window_s)\nreturn {\"allowed\": count <= int(limit), \"remaining\": max(0, int(limit) - count),\n        \"reset_in_s\": ttl}",
