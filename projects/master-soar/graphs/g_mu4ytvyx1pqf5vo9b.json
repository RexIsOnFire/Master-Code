        ],
        "code": "from soar.playbooks.validate import install_shipped_playbooks\nfrom soar.storage.db import Database\nfrom soar.storage.schema_ops import grant_runtime_privileges, seed_organisation, sync_builtin_roles\nfrom soar.storage.schema import apply_migrations\n\nimport os\n\ndsn = os.environ.get(\"SOAR_MIGRATE_DATABASE_URL\") or os.environ.get(\"SOAR_DATABASE_URL\")\nif not dsn:\n    raise RuntimeError(\"set SOAR_MIGRATE_DATABASE_URL\")\n\napplied = apply_migrations(dsn)\nprint(\"applied %d migration(s)\" % applied)\n\n# And then seed, which is the half this used to skip: the function was\n# called apply_and_seed and only applied, so every install came up with a\n# schema, no organisation, and no way to create the first administrator.\ndatabase = Database(dsn, \"migrate\")\ndatabase.connect()\nseeded = seed_organisation(database, os.environ.get(\"SOAR_ORG_NAME\")\n                           or \"Master SOAR\")\nif seeded.get(\"created\"):\n    print(\"seeded organisation %s with the built-in roles, the default \"\n          \"approval policies and the shipped commands\" % seeded[\"org_id\"])\nelse:\n    print(\"organisation %s already present\" % seeded[\"org_id\"])\n\ngrant_runtime_privileges(database)\n# Existing clients get the shipped playbooks too, so an upgrade that adds\n# one does not reach only the customers onboarded after it.\nfor client in database.query(\n        \"SELECT id FROM organisation WHERE kind = 'client'\", [], \"\"):\n    install_shipped_playbooks(database, client[\"id\"])\n\nsynced = sync_builtin_roles(database)\nif synced:\n    print(\"realigned %d built-in role permission(s) with this version\"\n          % synced)\n\nprint(\"no user was created; run: soar create-admin\")\n\nreturn applied",
        "doc": "Apply every pending migration, then seed a first organisation if the database is empty.",
        "form": "statements",
