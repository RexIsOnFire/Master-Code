      "props": {
        "doc": "Bind the process to its adapters, once, at boot.\n\nA deliberately small service registry rather than a dependency-injection\nframework. It holds the six ports - database, queue, object store, secrets,\nAI gateway and executor - and exists because the alternative was threading\nall six through every function signature down to the leaf.\n\nSet once by the role entry point and read everywhere. It is not a place to\nput request state: nothing here is per-request, and a value that varies by\ncaller does not belong in it.",
        "isAsync": false,
        "name": "configure",
        "params": [
          {
            "name": "services",
            "type": "Map<string, Any>"
          }
        ],
        "returns": "Void",
        "visibility": "public"
      },
      "type": "entry/function",
      "x": 0,
      "y": 0
    },
