        "doc": "Log the exception being handled, with its traceback stripped of locals.\n\nLocal variables are exactly where a credential lease or a rendered secret\nwould be sitting when something throws, so the traceback that reaches the log\nis frames and lines only.",
        "isAsync": false,
        "name": "log_exception",
        "params": [
          {
            "name": "correlation_id",
            "type": "string"
          }
        ],
        "returns": "Void",
        "visibility": "public"
