      "props": {
        "capabilities": [
          "stdio"
        ],
        "code": "from soar.platform.redact import redacting_encoder\n\nimport json\nimport sys\nimport time\n\nLEVELS = {\"debug\": 10, \"info\": 20, \"warning\": 30, \"error\": 40}\nthreshold = LEVELS.get(\n    (service_registry or {}).get(\"settings\", {}).get(\"log_level\", \"info\"), 20)\nif LEVELS.get(level, 20) < threshold:\n    return\n\nline = {\n    \"ts\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n    \"level\": level,\n    \"event\": event,\n}\nline.update(redacting_encoder(fields or {}))\nstream = sys.stderr if level in (\"warning\", \"error\") else sys.stdout\nstream.write(json.dumps(line, default=str) + \"\\n\")\nstream.flush()",
        "doc": "Structured logging: fields, never a formatted string.\n\nFields go through the secret-aware encoder, so a SecretValue that reaches a\nlog line is masked by its type rather than by the caller having remembered.\nThat is the whole reason logging is a function here instead of print().",
        "form": "statements",
        "language": "python",
