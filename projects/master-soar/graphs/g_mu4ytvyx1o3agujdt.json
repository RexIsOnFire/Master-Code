    {
      "id": "n_mu4ytvyx1ovxujhgp",
      "inputs": [
        {
          "direction": "in",
          "id": "in",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "in",
          "id": "p:correlation_id",
          "name": "correlation_id",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "direction": "out",
          "id": "out",
          "name": "",
          "type": "Exec"
        }
      ],
      "props": {
        "capabilities": [
          "stdio"
        ],
        "code": "import sys\nimport traceback\n\nkind, value, tb = sys.exc_info()\nframes = [\n    {\"file\": frame.filename, \"line\": frame.lineno, \"function\": frame.name}\n    for frame in traceback.extract_tb(tb)\n]\nlog_event(\"error\", \"unhandled_exception\", {\n    \"correlation_id\": correlation_id,\n    \"type\": kind.__name__ if kind else \"unknown\",\n    \"message\": str(value)[:2000],\n    \"frames\": frames[-12:],\n})",
        "doc": "Log the exception being handled, with its traceback stripped of locals.\n\nLocal variables are exactly where a credential lease or a rendered secret\nwould be sitting when something throws, so the traceback that reaches the log\nis frames and lines only.",
        "form": "statements",
        "language": "python",
