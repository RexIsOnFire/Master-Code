      "props": {
        "capabilities": [],
        "code": "from soar.audit.log import record as audit_record\nfrom soar.platform.ids import new_id\nfrom soar.platform.redact import redacting_encoder\n\nimport json\nimport secrets as pysecrets\n\napproval_id = new_id(\"appr\")\ndb.execute(\n    \"INSERT INTO approval (id, org_id, execution_id, step_id, incident_id, \"\n    \"requested_by_kind, requested_by_id, action_key, action_summary, risk_level, \"\n    \"payload, policy_id, required_permission, required_approvals, \"\n    \"separation_of_duty, nonce, expires_at) \"\n    \"VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s, \"\n    \"now() + (%s || ' seconds')::interval)\",\n    [\n        approval_id, org_id, context.get(\"execution_id\"), context.get(\"step_id\"),\n        context.get(\"incident_id\"), context.get(\"requested_by_kind\", \"playbook\"),\n        context.get(\"requested_by_id\"), context[\"action_key\"],\n        context[\"action_summary\"], context[\"risk_level\"],\n        json.dumps(redacting_encoder(context.get(\"payload\", {})), default=str),\n        decision.get(\"id\"), decision.get(\"required_permission\", \"approvals.decide\"),\n        decision.get(\"required_approvals\", 1),\n        decision.get(\"separation_of_duty\", True),\n        pysecrets.token_urlsafe(24), str(decision.get(\"timeout_s\", 1800)),\n    ],\n    org_id,\n)\nif context.get(\"step_id\"):\n    db.execute(\n        \"UPDATE execution_step SET status = 'waiting_approval', approval_id = %s \"\n        \"WHERE id = %s\", [approval_id, context[\"step_id\"]], org_id,\n    )\n    db.execute(\n        \"UPDATE execution SET status = 'waiting_approval' WHERE id = %s\",\n        [context[\"execution_id\"]], org_id,\n    )\naudit_record(db, {\n    \"org_id\": org_id, \"actor_kind\": context.get(\"requested_by_kind\", \"playbook\"),\n    \"actor_id\": context.get(\"requested_by_id\"), \"action\": \"approval.requested\",\n    \"target_kind\": \"approval\", \"target_id\": approval_id,\n    \"execution_id\": context.get(\"execution_id\"),\n    \"after\": {\"action_key\": context[\"action_key\"],\n              \"risk_level\": context[\"risk_level\"]},\n    \"result\": \"success\",\n})\nreturn approval_id",
        "doc": "Create a pending approval and suspend the execution. Suspended means a row, not a held thread - a waiting approval costs nothing and survives a restart.",
