      "props": {
        "capabilities": [],
        "code": "from soar.audit.log import record as audit_record\nfrom soar.identity.rbac import require_permission\n\nimport hmac\n\norg_id = principal[\"org_id\"]\nrows = db.query(\n    \"SELECT * FROM approval WHERE id = %s AND org_id = %s\",\n    [approval_id, org_id], org_id,\n)\nif not rows:\n    raise KeyError(\"no such approval\")\napproval = rows[0]\n\nif approval[\"status\"] != \"pending\":\n    raise ValueError(\"this approval is already %s\" % approval[\"status\"])\n\nrequire_permission(principal, approval[\"required_permission\"])\n\n# The nonce is bound to this specific request, so a captured \"approve\" from\n# an earlier action cannot be replayed against a later one.\nif not hmac.compare_digest(approval[\"nonce\"], nonce or \"\"):\n    raise PermissionError(\"approval nonce mismatch\")\n\nif approval[\"separation_of_duty\"] and approval[\"requested_by_id\"] == principal.get(\"id\"):\n    raise PermissionError(\"the requester cannot approve their own action\")\n\nif approval[\"risk_level\"] == \"high\" and not step_up_satisfied:\n    raise PermissionError(\"approving a high-risk action requires re-authentication\")\n\ndb.execute(\n    \"INSERT INTO approval_decision (approval_id, decider_id, decision, reason, \"\n    \"step_up_satisfied) VALUES (%s, %s, %s, %s, %s)\",\n    [approval_id, principal[\"id\"], decision, reason, step_up_satisfied],\n    org_id,\n)\n\ndecisions = db.query(\n    \"SELECT decision FROM approval_decision WHERE approval_id = %s\",\n    [approval_id], org_id,\n)\nrejected = any(d[\"decision\"] == \"reject\" for d in decisions)\napproved = sum(1 for d in decisions if d[\"decision\"] == \"approve\")\n\nfinal = None\nif rejected:\n    final = \"rejected\"\nelif approved >= approval[\"required_approvals\"]:\n    final = \"approved\"\n\nif final:\n    db.execute(\n        \"UPDATE approval SET status = %s, decided_at = now() WHERE id = %s\",\n        [final, approval_id], org_id,\n    )\n\naudit_record(db, {\n    \"org_id\": org_id, \"actor_kind\": \"user\", \"actor_id\": principal.get(\"id\"),\n    \"action\": \"approval.decided\", \"target_kind\": \"approval\",\n    \"target_id\": approval_id, \"approval_id\": approval_id,\n    \"execution_id\": approval.get(\"execution_id\"),\n    \"after\": {\"decision\": decision, \"final\": final},\n    \"reason\": reason, \"result\": \"success\",\n})\nreturn {\"status\": final or \"pending\",\n        \"approvals\": approved,\n        \"required\": approval[\"required_approvals\"]}",
        "doc": "Record one decision. Five checks, all of which have to hold:\nthe permission, the nonce, separation of duty, step-up for HIGH, and the\napproval still being pending.",
