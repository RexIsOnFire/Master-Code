      "props": {
        "doc": "The worker loop.\n\nA worker holds no long-lived secret: the root key is not on it, only\nper-job leases are. The sandbox pool additionally has no Postgres route and\nno credential lease at all, which is enforced by its Redis ACL and its\nnetwork, not by this code being careful.",
        "isAsync": false,
        "name": "run_worker_role",
        "params": [
