      "props": {
        "capabilities": [
          "net"
        ],
        "code": "import httpx\n\nsystem = \"\\n\\n\".join(m[\"content\"] for m in messages if m[\"role\"] == \"system\")\nturns = [m for m in messages if m[\"role\"] != \"system\"]\n\nbody = {\n    \"model\": self.model,\n    \"system\": system,\n    \"messages\": turns,\n    \"max_tokens\": options.get(\"max_tokens\", 2048),\n    \"temperature\": options.get(\"temperature\", 0.1),\n}\nif tools:\n    body[\"tools\"] = [\n        {\"name\": t[\"name\"], \"description\": t[\"description\"],\n         \"input_schema\": t[\"input_schema\"]}\n        for t in tools\n    ]\n\nwith httpx.Client(timeout=options.get(\"timeout_s\", 120)) as client:\n    response = client.post(\n        self.base_url.rstrip(\"/\") + \"/v1/messages\",\n        headers={\"x-api-key\": self.credential.reveal(),\n                 \"anthropic-version\": \"2023-06-01\",\n                 \"content-type\": \"application/json\"},\n        json=body,\n    )\n    if response.status_code >= 400:\n        raise RuntimeError(\"anthropic returned %d: %s\"\n                           % (response.status_code, response.text[:500]))\n    payload = response.json()\n\ntext = \"\".join(block.get(\"text\", \"\") for block in payload.get(\"content\", [])\n               if block.get(\"type\") == \"text\")\ncalls = [{\"name\": block[\"name\"], \"arguments\": block.get(\"input\", {})}\n         for block in payload.get(\"content\", [])\n         if block.get(\"type\") == \"tool_use\"]\nusage = payload.get(\"usage\", {})\nreturn {\n    \"text\": text,\n    \"tool_calls\": calls,\n    \"tokens_in\": usage.get(\"input_tokens\", 0),\n    \"tokens_out\": usage.get(\"output_tokens\", 0),\n    \"finish_reason\": payload.get(\"stop_reason\", \"stop\"),\n    \"model\": payload.get(\"model\", self.model),\n}",
        "doc": "One turn. System messages are hoisted into the system field, which keeps the instruction channel separate from the evidence by construction.",
        "form": "statements",
        "language": "python",
