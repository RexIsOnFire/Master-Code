      "props": {
        "capabilities": [
          "net"
        ],
        "code": "import httpx\n\nbody = {\n    \"model\": self.model,\n    \"messages\": messages,\n    \"stream\": False,\n    \"options\": {\"temperature\": options.get(\"temperature\", 0.1),\n                \"num_predict\": options.get(\"max_tokens\", 2048)},\n}\nif tools:\n    body[\"tools\"] = tools\n\nwith httpx.Client(timeout=options.get(\"timeout_s\", 120)) as client:\n    response = client.post(self.base_url.rstrip(\"/\") + \"/api/chat\", json=body)\n    response.raise_for_status()\n    payload = response.json()\n\nmessage = payload.get(\"message\", {})\nreturn {\n    \"text\": message.get(\"content\", \"\"),\n    \"tool_calls\": message.get(\"tool_calls\", []),\n    \"tokens_in\": payload.get(\"prompt_eval_count\", 0),\n    \"tokens_out\": payload.get(\"eval_count\", 0),\n    \"finish_reason\": \"stop\" if payload.get(\"done\") else \"length\",\n    \"model\": self.model,\n}",
        "doc": "One turn against a local model, normalised into the platform response shape.",
        "form": "statements",
        "language": "python",
        "name": "ollama_complete",
