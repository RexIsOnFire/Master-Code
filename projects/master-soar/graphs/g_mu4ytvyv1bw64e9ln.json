        "code": "return {\n    \"fast\": {\"provider\": \"ollama\", \"model\": \"llama3.1:8b\",\n             \"use\": \"extraction, classification, summarisation\",\n             \"max_tokens\": 2048, \"temperature\": 0.1},\n    \"investigation\": {\"provider\": \"ollama\", \"model\": \"llama3.1:70b\",\n                      \"use\": \"multi-step tool-using investigation\",\n                      \"max_tokens\": 8192, \"temperature\": 0.2},\n    \"reasoning\": {\"provider\": \"ollama\", \"model\": \"llama3.1:70b\",\n                  \"use\": \"analysis, recommendations, playbook drafting\",\n                  \"max_tokens\": 8192, \"temperature\": 0.3},\n    \"embedding\": {\"provider\": \"ollama\", \"model\": \"nomic-embed-text\",\n                  \"use\": \"similarity search over incidents and intel\",\n                  \"max_tokens\": 512, \"temperature\": 0.0},\n}",
