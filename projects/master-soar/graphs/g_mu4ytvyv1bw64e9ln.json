      "props": {
        "capabilities": [],
        "code": "rows = db.query(\n    \"SELECT r.model, r.params, p.id, p.kind, p.base_url, p.credential_id, \"\n    \"p.enabled, p.health \"\n    \"FROM ai_model_role r JOIN ai_provider p ON p.id = r.provider_id \"\n    \"WHERE r.org_id = %s AND r.role = %s\", [org_id, role], org_id,\n)\nif not rows:\n    raise KeyError(\n        \"no provider is configured for the %r role; \"\n        \"set one in Administration > AI, or start the ai-local profile\" % role\n    )\nroute = rows[0]\nif not route[\"enabled\"]:\n    raise RuntimeError(\"the provider for role %r is disabled\" % role)\n\nlocal_kinds = (\"ollama\", \"openai_compatible\")\nsettings = db.query(\n    \"SELECT settings FROM organisation WHERE id = %s\", [org_id], org_id\n)\nlocal_only = bool((settings[0][\"settings\"] if settings else {}).get(\"ai_local_only\"))\n\nif contains_incident_data and local_only and route[\"kind\"] not in local_kinds:\n    raise PermissionError(\n        \"this organisation is configured local-only for AI; the %r role is \"\n        \"bound to %s, which is external. Change the binding or the policy - \"\n        \"the request will not be silently downgraded.\" % (role, route[\"kind\"])\n    )\nreturn route",
        "doc": "Choose the provider for a role, and refuse rather than downgrade.\n\nData residency is a first-class setting: if an organisation marks a role\nlocal-only, a request carrying incident content to an external provider is\nrefused with a clear reason. Silently routing it somewhere else would be\nthe worst possible behaviour for a SOC tool.",
        "form": "statements",
        "language": "python",
        "name": "select_provider_for_role",
        "packages": [],
        "params": [
