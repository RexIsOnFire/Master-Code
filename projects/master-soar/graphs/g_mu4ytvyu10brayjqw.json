      "props": {
        "capabilities": [],
        "code": "from soar.audit.log import record as audit_record\nfrom soar.identity.rbac import require_permission\nfrom soar.playbooks.validate import validate_playbook\n\nrequire_permission(principal, \"playbooks.publish\")\norg_id = principal[\"org_id\"]\n\nrows = db.query(\n    \"SELECT pv.id, pv.state, pv.playbook_id, pv.created_by, pv.test_results, \"\n    \"pv.definition, pv.content_sha256 \"\n    \"FROM playbook_version pv JOIN playbook p ON p.id = pv.playbook_id \"\n    \"WHERE pv.id = %s AND p.org_id = %s\",\n    [version_id, org_id], org_id,\n)\nif not rows:\n    raise KeyError(\"no such playbook version\")\nversion = rows[0]\n\nif not can_transition(version[\"state\"], \"published\"):\n    raise ValueError(\n        \"a %s version cannot be published; edit it as a new draft\"\n        % version[\"state\"]\n    )\n\nproblems = validate_playbook(version[\"definition\"])\nif problems:\n    raise ValueError(\"validation failed: \" + \"; \".join(problems))\n\nresults = version.get(\"test_results\") or {}\nif not results.get(\"passed\"):\n    raise ValueError(\"publish requires a passing simulation run\")\n\nif require_dual and version[\"created_by\"] == principal.get(\"id\"):\n    raise PermissionError(\n        \"dual publish is enabled: a second principal must publish this version\"\n    )\n\ndb.execute(\n    \"UPDATE playbook_version SET state = 'deprecated' \"\n    \"WHERE playbook_id = %s AND state = 'published'\",\n    [version[\"playbook_id\"]], org_id,\n)\ndb.execute(\n    \"UPDATE playbook_version SET state = 'published', published_at = now(), \"\n    \"published_by = %s WHERE id = %s AND state = %s\",\n    [principal.get(\"id\"), version_id, version[\"state\"]], org_id,\n)\ndb.execute(\n    \"UPDATE playbook SET current_version_id = %s WHERE id = %s\",\n    [version_id, version[\"playbook_id\"]], org_id,\n)\naudit_record(db, {\n    \"org_id\": org_id, \"actor_kind\": \"user\", \"actor_id\": principal.get(\"id\"),\n    \"action\": \"playbook.publish\", \"target_kind\": \"playbook_version\",\n    \"target_id\": version_id,\n    \"after\": {\"sha256\": bytes(version[\"content_sha256\"]).hex()},\n    \"result\": \"success\",\n})",
        "doc": "Publish a playbook version.\n\nFour gates, in order: permission; the transition is legal; validation is\nclean; a simulation has passed. Dual publish adds a fifth - a second\nprincipal - which is the mitigation for the malicious-insider case and is\nconfiguration, not a hard-coded policy.",
        "form": "statements",
        "language": "python",
        "name": "publish_playbook_version",
        "packages": [],
        "params": [
          {
            "name": "db",
            "type": "Any"
