        }
      ],
      "props": {
        "doc": "Diff two versions by what changed in the graph, not by lines of JSON. A reviewer needs \"step 4 now calls isolate_host instead of notify\", not a hunk.",
        "isAsync": false,
        "name": "structural_diff",
        "params": [
          {
            "name": "before",
            "type": "Map<string, Any>"
          },
          {
            "name": "after",
            "type": "Map<string, Any>"
          }
        ],
        "returns": "List<Map<string, Any>>",
        "visibility": "public"
      },
      "type": "entry/function",
      "x": 0,
      "y": 650
    },
    {
      "id": "n_mu4ytvyu114g0d894",
      "inputs": [
        {
          "direction": "in",
          "id": "in",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "in",
          "id": "p:before",
          "name": "before",
          "type": "Map<string, Any>"
        },
        {
          "direction": "in",
          "id": "p:after",
          "name": "after",
          "type": "Map<string, Any>"
        }
      ],
      "outputs": [
        {
          "direction": "out",
          "id": "out",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "out",
          "id": "result",
          "name": "result",
          "type": "List<Map<string, Any>>"
        }
      ],
      "props": {
        "capabilities": [],
        "code": "changes = []\nold_nodes = (before or {}).get(\"nodes\", {})\nnew_nodes = (after or {}).get(\"nodes\", {})\n\nfor node_id in sorted(set(new_nodes) - set(old_nodes)):\n    changes.append({\"change\": \"added\", \"node\": node_id,\n                    \"kind\": new_nodes[node_id].get(\"kind\")})\nfor node_id in sorted(set(old_nodes) - set(new_nodes)):\n    changes.append({\"change\": \"removed\", \"node\": node_id,\n                    \"kind\": old_nodes[node_id].get(\"kind\")})\nfor node_id in sorted(set(old_nodes) & set(new_nodes)):\n    old, new = old_nodes[node_id], new_nodes[node_id]\n    for field in sorted(set(old) | set(new)):\n        if old.get(field) != new.get(field):\n            changes.append({\"change\": \"modified\", \"node\": node_id,\n                            \"field\": field, \"before\": old.get(field),\n                            \"after\": new.get(field)})\nreturn changes",
