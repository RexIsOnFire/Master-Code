      ],
      "props": {
        "doc": "The two roles. Admin and Analyst.\n\nAdmin sees everything in the platform - the whole permission catalogue, so\nthe two can never drift apart as capabilities are added.\n\nAnalyst sees the dashboard, detections and alerts, and nothing else.\nPlaybooks, commands, integrations, intel, credentials, clients, reports and\nadministration are not theirs. The rail hides what they cannot open, so the\nscreen is four items rather than fifteen with eleven refusals behind them.",
        "isAsync": false,
        "name": "builtin_roles",
        "params": [],
        "returns": "Map<string, Any>",
        "visibility": "public"
      },
      "type": "entry/function",
      "x": 0,
