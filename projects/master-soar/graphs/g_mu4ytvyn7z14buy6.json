      ],
      "props": {
        "doc": "What this user may do, right now, from the roles they hold.\n\nRead on every request rather than once at sign-in. A permission list\nfrozen into a session is a role change that does not take effect until\nthe person signs out - which means a role REMOVED mid-shift keeps\nworking, and a capability added to the platform reaches nobody who is\nalready signed in. Both were true here.\n\nIt is one indexed lookup on two small tables. That is the right price for\nan authorisation decision being about the present rather than about\nwhenever the browser tab was opened.",
        "isAsync": false,
        "name": "live_permissions",
        "params": [
          {
            "name": "db",
            "type": "Any"
          },
          {
            "name": "user_id",
            "type": "string"
          },
          {
            "name": "org_id",
            "type": "string"
          }
        ],
        "returns": "List<string>",
        "visibility": "public"
      },
      "type": "entry/function",
