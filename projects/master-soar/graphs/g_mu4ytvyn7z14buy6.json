            "name": "target_user_id",
            "type": "string"
          },
          {
            "name": "role_permissions",
            "type": "List<string>"
          },
          {
            "name": "mfa_enrolled",
            "type": "bool"
          }
        ],
        "returns": "Void"
      },
      "type": "custom/code",
      "x": 250,
