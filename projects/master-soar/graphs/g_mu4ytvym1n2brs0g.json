      "props": {
        "capabilities": [],
        "code": "if isinstance(value, SecretValue):\n    return value.masked()\nif isinstance(value, dict):\n    return {k: redacting_encoder(v) for k, v in value.items()}\nif isinstance(value, (list, tuple)):\n    return [redacting_encoder(v) for v in value]\nreturn value",
