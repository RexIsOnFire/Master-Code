          "type": "Exec"
        },
        {
          "direction": "out",
          "id": "result",
          "name": "result",
          "type": "Any"
        }
      ],
      "props": {
        "capabilities": [],
        "code": "candidates = []\nif date_added_last:\n    candidates.append(str(date_added_last))\nelse:\n    for entry in objects or []:\n        if not isinstance(entry, dict):\n            continue\n        stamp = entry.get(\"modified\") or entry.get(\"created\")\n        if stamp:\n            candidates.append(str(stamp))\n\nbest = None\nbest_moment = None\nfor candidate in candidates:\n    moment = taxii_moment(candidate)\n    if moment is None:\n        continue\n    if best_moment is None or moment > best_moment:\n        best = candidate\n        best_moment = moment\n\nif best is None:\n    return current\nheld = taxii_moment(current)\nif held is not None and held >= best_moment:\n    return current\nreturn best",
        "doc": "Where the next poll should resume from.\n\nThe server's own X-TAXII-Date-Added-Last is preferred, because it refers to\nwhen the server accepted the object, which is what `added_after` filters on.\nAn object's `modified` is a different clock and using it as a substitute is\nthe classic way to miss objects that were added late but modified early.\n\nWhen the header is absent the newest `modified` is the only thing available,\nand it is imprecise enough that the next poll may re-read a few objects.\nThat is the safe direction: ingestion is an upsert, so re-reading costs\nnothing, while skipping loses indicators silently.\n\nA watermark never moves backwards.",
