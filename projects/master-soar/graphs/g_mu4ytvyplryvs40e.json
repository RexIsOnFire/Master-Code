      "props": {
        "capabilities": [],
        "code": "import json\n\ntry:\n    document = json.loads(payload)\nexcept ValueError as error:\n    return {\"objects\": [], \"more\": False, \"next\": None,\n            \"errors\": [\"envelope is not JSON: %s\" % error]}\n\nif isinstance(document, list):\n    return {\"objects\": document, \"more\": False, \"next\": None, \"errors\": []}\nif not isinstance(document, dict):\n    return {\"objects\": [], \"more\": False, \"next\": None,\n            \"errors\": [\"envelope is neither an object nor a list\"]}\n\nobjects = document.get(\"objects\")\nif not isinstance(objects, list):\n    objects = []\nreturn {\"objects\": objects,\n        \"more\": bool(document.get(\"more\")),\n        \"next\": document.get(\"next\") or None,\n        \"errors\": []}",
        "doc": "Read one page of objects.\n\nHandles both shapes: a 2.1 envelope, which carries `more` and `next`, and a\n2.0 STIX bundle, which carries neither because 2.0 pages by Range header.\nFor a bundle `more` comes back False and the caller decides from the\nContent-Range it was given.",
