      ],
      "props": {
        "doc": "The Accept header for one TAXII endpoint.\n\nVersion negotiation in TAXII is done entirely through this header, and a 2.0\nserver answers 406 to the 2.1 media type rather than falling back - so\ngetting it wrong looks like an auth or a routing problem and is neither.\nThe objects endpoint is the odd one: in 2.0 it returns STIX and carries the\nSTIX media type, while in 2.1 it returns a TAXII envelope.",
        "isAsync": false,
        "name": "taxii_accept",
        "params": [
          {
            "name": "version",
            "type": "string"
          },
