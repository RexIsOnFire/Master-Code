      ],
      "props": {
        "doc": "Read a TAXII discovery response into the API roots it offers.\n\nThe default root is listed first when the server names one, because that is\nthe root it expects an unconfigured client to use. It is not always present\nin api_roots, which is a spec quirk rather than an error.\n\nRoots are resolved against the discovery URL. The spec calls them URLs and\nreal servers return paths - the ATT&CK TAXII server answers `/api/v21/` -\nso taking them literally produces a request with no scheme and a confusing\nerror a long way from the cause.",
        "isAsync": false,
        "name": "taxii_discovery",
        "params": [
          {
            "name": "payload",
            "type": "string"
          },
          {
            "name": "base_url",
            "type": "string"
          }
        ],
        "returns": "Map<string, Any>",
        "visibility": "public"
      },
      "type": "entry/function",
      "x": 0,
      "y": 130
    },
    {
      "id": "n_mu4ytvypm1hzxqpm",
      "inputs": [
        {
          "direction": "in",
          "id": "in",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "in",
          "id": "p:payload",
          "name": "payload",
          "type": "string"
        },
        {
          "direction": "in",
          "id": "p:base_url",
          "name": "base_url",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "direction": "out",
          "id": "out",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "out",
          "id": "result",
          "name": "result",
          "type": "Map<string, Any>"
        }
      ],
      "props": {
        "capabilities": [],
        "code": "import json\nimport urllib.parse\n\ntry:\n    document = json.loads(payload)\nexcept ValueError as error:\n    return {\"title\": None, \"default\": None, \"api_roots\": [],\n            \"errors\": [\"discovery response is not JSON: %s\" % error]}\nif not isinstance(document, dict):\n    return {\"title\": None, \"default\": None, \"api_roots\": [],\n            \"errors\": [\"discovery response is not an object\"]}\n\ndef absolute(entry):\n    return urllib.parse.urljoin(base_url or \"\", str(entry).rstrip(\"/\") + \"/\")\n\nroots = []\nfor entry in document.get(\"api_roots\") or []:\n    if not entry:\n        continue\n    root = absolute(entry)\n    if root not in roots:\n        roots.append(root)\n\ndefault = document.get(\"default\")\nif default:\n    default = absolute(default)\n    if default in roots:\n        roots.remove(default)\n    roots.insert(0, default)\n\nreturn {\"title\": document.get(\"title\"), \"default\": default,\n        \"api_roots\": roots, \"errors\": []}",
        "doc": "Read a TAXII discovery response into the API roots it offers.\n\nThe default root is listed first when the server names one, because that is\nthe root it expects an unconfigured client to use. It is not always present\nin api_roots, which is a spec quirk rather than an error.\n\nRoots are resolved against the discovery URL. The spec calls them URLs and\nreal servers return paths - the ATT&CK TAXII server answers `/api/v21/` -\nso taking them literally produces a request with no scheme and a confusing\nerror a long way from the cause.",
