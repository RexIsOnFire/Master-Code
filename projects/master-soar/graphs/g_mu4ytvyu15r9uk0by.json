        "code": "import hmac\nimport json\n\ntry:\n    self.client.xgroup_create(stream, self.group, id=\"0\", mkstream=True)\nexcept Exception:\n    pass  # the group already exists, which is the normal case\n\nentries = self.client.xreadgroup(\n    self.group, consumer, {stream: \">\"}, count=1, block=5000\n)\nif not entries:\n    return {}\n\n_, messages = entries[0]\njob_id, fields = messages[0]\npayload = json.loads(fields[\"payload\"])\nexpected = sign_job(payload, self.signing_key)\nif not hmac.compare_digest(expected, fields.get(\"signature\", \"\")):\n    self.client.xack(stream, self.group, job_id)\n    raise PermissionError(\"job signature invalid; discarded and acknowledged\")\nreturn {\"job_id\": job_id, \"job\": payload}",
