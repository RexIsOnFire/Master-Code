        "code": "import json\n\nif not job.get(\"idempotency_key\"):\n    raise ValueError(\n        \"every job carries (execution_id, step_id, attempt); \"\n        \"without it a redelivery would re-run the step\"\n    )\nenvelope = {\n    \"payload\": json.dumps(job, sort_keys=True, default=str),\n    \"signature\": sign_job(job, self.signing_key),\n}\nreturn self.client.xadd(stream, envelope, maxlen=100000, approximate=True)",
