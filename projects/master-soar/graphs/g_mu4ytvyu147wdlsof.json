        "code": "import ast\n\nDANGEROUS_MODULES = {\"subprocess\", \"ctypes\", \"socket\", \"shutil\", \"pty\",\n                     \"multiprocessing\", \"importlib\", \"pickle\", \"marshal\"}\nDANGEROUS_CALLS = {\"eval\", \"exec\", \"compile\", \"__import__\", \"open\", \"input\",\n                   \"globals\", \"locals\", \"vars\", \"getattr\", \"setattr\"}\n\nfindings = []\ntry:\n    tree = ast.parse(source)\nexcept SyntaxError as error:\n    return [{\"severity\": \"error\", \"code\": \"syntax\", \"message\": str(error)}]\n\nfor node in ast.walk(tree):\n    if isinstance(node, (ast.Import, ast.ImportFrom)):\n        names = [a.name.split(\".\")[0] for a in getattr(node, \"names\", [])]\n        if isinstance(node, ast.ImportFrom) and node.module:\n            names.append(node.module.split(\".\")[0])\n        for name in names:\n            if name in DANGEROUS_MODULES:\n                findings.append({\n                    \"severity\": \"high\", \"code\": \"dangerous-import\",\n                    \"line\": node.lineno,\n                    \"message\": \"imports %s\" % name,\n                })\n    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):\n        if node.func.id in DANGEROUS_CALLS:\n            findings.append({\n                \"severity\": \"high\", \"code\": \"dynamic-execution\",\n                \"line\": node.lineno,\n                \"message\": \"calls %s\" % node.func.id,\n            })\n    if isinstance(node, ast.Attribute) and node.attr.startswith(\"__\"):\n        findings.append({\n            \"severity\": \"medium\", \"code\": \"dunder-access\",\n            \"line\": getattr(node, \"lineno\", 0),\n            \"message\": \"reaches %s\" % node.attr,\n        })\n\nif trust_level == \"untrusted\" and findings:\n    for finding in findings:\n        finding[\"effect\"] = \"runs in the sandbox regardless; review before promoting\"\nreturn findings",
