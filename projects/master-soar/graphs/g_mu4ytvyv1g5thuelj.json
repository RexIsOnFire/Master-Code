      "props": {
        "capabilities": [],
        "code": "from soar.ai.tools import build_tool_set\nfrom soar.audit.log import record as audit_record\nfrom soar.identity.rbac import intersect_for_ai, require_permission\nfrom soar.platform.ids import new_id\n\nrequire_permission(principal, \"ai.use\")\norg_id = principal[\"org_id\"]\n\ntool_set = build_tool_set(db, principal, purpose)\neffective = intersect_for_ai(\n    principal.get(\"permissions\") or [],\n    [t[\"required_permission\"] for t in tool_set],\n)\n\nsession_id = new_id(\"ais\")\ndb.execute(\n    \"INSERT INTO ai_session (id, org_id, user_id, incident_id, purpose, \"\n    \"principal_permissions, started_at) VALUES (%s,%s,%s,%s,%s,%s, now())\",\n    [session_id, org_id, principal[\"id\"], incident_id or None, purpose, effective],\n    org_id,\n)\naudit_record(db, {\n    \"org_id\": org_id, \"actor_kind\": \"user\", \"actor_id\": principal[\"id\"],\n    \"action\": \"ai.session.opened\", \"target_kind\": \"ai_session\",\n    \"target_id\": session_id, \"ai_session_id\": session_id,\n    \"after\": {\"purpose\": purpose, \"tools\": [t[\"name\"] for t in tool_set],\n              \"permissions\": effective},\n    \"result\": \"success\",\n})\nreturn {\"id\": session_id, \"org_id\": org_id, \"user_id\": principal[\"id\"],\n        \"incident_id\": incident_id, \"purpose\": purpose,\n        \"permissions\": effective, \"tools\": tool_set}",
        "doc": "Open an AI session and freeze its capability.\n\nThe tool set and the effective permissions are computed here, before any\nincident content is read, and both are recorded on the session row - so the\naudit shows not only what the AI did but what it COULD have done.",
