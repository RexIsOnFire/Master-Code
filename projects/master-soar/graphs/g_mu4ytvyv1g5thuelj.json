        "code": "org_id = session[\"org_id\"]\nreturn {\n    \"tools\": [{\"name\": t[\"name\"], \"description\": t[\"description\"],\n               \"risk_level\": t[\"risk_level\"],\n               \"requires_approval\": t[\"requires_approval\"]}\n              for t in session.get(\"tools\", [])],\n    \"playbooks\": db.query(\n        \"SELECT p.key, p.name, p.description FROM playbook p \"\n        \"JOIN playbook_version pv ON pv.id = p.current_version_id \"\n        \"WHERE p.org_id = %s AND pv.state = 'published'\", [org_id], org_id),\n    \"integrations\": db.query(\n        \"SELECT name, connector_id, health FROM integration \"\n        \"WHERE org_id = %s AND enabled\", [org_id], org_id),\n}",
