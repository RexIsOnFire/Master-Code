      "props": {
        "capabilities": [],
        "code": "org_id = session[\"org_id\"]\nincident_id = session.get(\"incident_id\")\nif not incident_id:\n    return {\"incident\": None, \"capabilities\": ai_capabilities(db, session)}\n\nreturn {\n    \"incident\": db.query(\n        \"SELECT id, number, title, severity, status, technique_ids, created_at \"\n        \"FROM incident WHERE id = %s\", [incident_id], org_id)[0],\n    \"alerts\": db.query(\n        \"SELECT id, source, title, severity, observed_at FROM alert \"\n        \"WHERE incident_id = %s ORDER BY observed_at\", [incident_id], org_id),\n    \"entities\": db.query(\n        \"SELECT entity_kind, entity_id, role FROM incident_entity \"\n        \"WHERE incident_id = %s\", [incident_id], org_id),\n    \"indicators\": db.query(\n        \"SELECT i.id, i.type, i.value, i.verdict, i.score FROM incident_indicator ii \"\n        \"JOIN indicator i ON i.id = ii.indicator_id WHERE ii.incident_id = %s\",\n        [incident_id], org_id),\n    \"timeline\": db.query(\n        \"SELECT at, kind, actor_kind, summary FROM timeline_entry \"\n        \"WHERE incident_id = %s ORDER BY seq DESC LIMIT 50\", [incident_id], org_id),\n    \"capabilities\": ai_capabilities(db, session),\n}",
        "doc": "What the assistant knows, assembled from the platform.\n\nThis is why \"What can I do with this incident?\" has a truthful answer: the\ncatalogue of real commands and real integrations is supplied as data, so the\nmodel is not asked to remember a product surface it would otherwise invent.",
