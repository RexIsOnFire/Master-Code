        "code": "from soar.platform.redact import SecretValue\n\nimport json\nimport urllib.parse\n\nif isinstance(value, SecretValue):\n    if position in (\"header\", \"json\", \"body\"):\n        return value.reveal()\n    return value.masked()\n\nif value is None:\n    return \"\"\nif position == \"url\":\n    return urllib.parse.quote(str(value), safe=\"\")\nif position == \"json\":\n    encoded = json.dumps(value, default=str)\n    return encoded[1:-1] if isinstance(value, str) else encoded\nif position == \"html\":\n    return (str(value).replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\")\n            .replace(\">\", \"&gt;\").replace('\"', \"&quot;\"))\nreturn str(value)",
