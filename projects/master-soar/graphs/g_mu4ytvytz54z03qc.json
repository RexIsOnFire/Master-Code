      "props": {
        "capabilities": [],
        "code": "import re\n\ncurrent = context\nfor segment in re.findall(r\"[^.\\[\\]]+|\\[\\d+\\]\", path or \"\"):\n    if segment.startswith(\"[\"):\n        index = int(segment[1:-1])\n        if not isinstance(current, (list, tuple)) or index >= len(current):\n            return None\n        current = current[index]\n        continue\n    if not isinstance(current, dict):\n        return None\n    if segment not in current:\n        return None\n    current = current[segment]\nreturn current",
        "doc": "Walk a dotted path with optional list indexing. Dictionary keys and list indices only - never a Python attribute, never a method, never a builtin.",
