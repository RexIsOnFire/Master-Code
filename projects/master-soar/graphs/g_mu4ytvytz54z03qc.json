      "props": {
        "capabilities": [],
        "code": "from soar.intel.indicators import defang, refang\n\nimport json\nimport urllib.parse\n\nname, _, argument = spec.partition(\"(\")\nargument = argument.rstrip(\")\").strip(\"'\\\"\")\nname = name.strip()\n\nif name == \"default\":\n    return value if value not in (None, \"\", [], {}) else argument\n\n# A filter that turns text into text has nothing to say about a value\n# that is not there. str(None) is \"None\", and an optional input that\n# renders as the four letters None is a query filter nobody wrote.\nif value is None and name in (\"upper\", \"lower\", \"urlencode\", \"html\",\n                              \"defang\", \"refang\"):\n    return \"\"\n\nif name == \"upper\":\n    return str(value).upper()\nif name == \"lower\":\n    return str(value).lower()\nif name == \"json\":\n    return json.dumps(value, default=str)\nif name == \"urlencode\":\n    return urllib.parse.quote(str(value), safe=\"\")\nif name == \"html\":\n    return (str(value).replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\")\n            .replace(\">\", \"&gt;\").replace('\"', \"&quot;\"))\nif name == \"defang\":\n    return defang(str(value))\nif name == \"refang\":\n    return refang(str(value))\nif name == \"first\":\n    return value[0] if isinstance(value, (list, tuple)) and value else None\nif name == \"last\":\n    return value[-1] if isinstance(value, (list, tuple)) and value else None\nif name == \"join\":\n    return (argument or \", \").join(str(v) for v in (value or []))\nif name == \"length\":\n    return len(value or [])\nif name == \"int\":\n    return int(value)\nif name == \"float\":\n    return float(value)\nif name == \"bool\":\n    return bool(value)\nraise ValueError(\"unknown filter %r; the filter set is fixed on purpose\" % name)",
        "doc": "The complete filter set. Fixed, small, and containing nothing that can reach the interpreter.",
