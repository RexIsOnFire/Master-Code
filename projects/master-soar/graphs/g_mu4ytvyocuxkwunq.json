      "props": {
        "doc": "Structural check on a normalised alert. A mapping that produces a malformed alert fails at ingest, where it is a configuration problem, rather than three steps into a playbook at 03:00.",
        "isAsync": false,
        "name": "validate_alert",
        "params": [
          {
            "name": "alert",
            "type": "Map<string, Any>"
          }
        ],
        "returns": "List<string>",
        "visibility": "public"
      },
      "type": "entry/function",
      "x": 0,
      "y": 650
    },
    {
      "id": "n_mu4ytvyodjyudwox",
      "inputs": [
        {
          "direction": "in",
          "id": "in",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "in",
          "id": "p:alert",
          "name": "alert",
          "type": "Map<string, Any>"
        }
      ],
      "outputs": [
        {
          "direction": "out",
          "id": "out",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "out",
          "id": "result",
          "name": "result",
          "type": "List<string>"
        }
      ],
      "props": {
        "capabilities": [],
        "code": "problems = []\nif alert.get(\"schema\") != \"csem/1\":\n    problems.append(\"schema must be csem/1\")\nfor field in (\"source\", \"vendor_alert_id\", \"title\", \"observed_at\"):\n    if not alert.get(field):\n        problems.append(\"missing required field: \" + field)\nif alert.get(\"severity\") not in (\"info\", \"low\", \"medium\", \"high\", \"critical\"):\n    problems.append(\"severity outside the platform scale\")\nif not isinstance(alert.get(\"entities\"), list):\n    problems.append(\"entities must be a list\")\nif not isinstance(alert.get(\"indicators\"), list):\n    problems.append(\"indicators must be a list\")\n\n# An indicator whose value is an object is a mapping pointing one level\n# too high. It used to pass, and what reached the analyst queue was the\n# repr of a dict presented as an IP address.\nfor indicator in alert.get(\"indicators\") or []:\n    value = indicator.get(\"value\") if isinstance(indicator, dict) else None\n    if isinstance(value, (dict, list)):\n        problems.append(\n            \"indicator %r resolved to a %s, so its mapping names a \"\n            \"container rather than a value\"\n            % (indicator.get(\"type\"), type(value).__name__))\n    elif value in (None, \"\"):\n        problems.append(\"indicator %r has no value\"\n                        % indicator.get(\"type\"))\n\nfor entity in alert.get(\"entities\") or []:\n    for key, value in (entity or {}).items():\n        if isinstance(value, (dict, list)):\n            problems.append(\n                \"entity field %r resolved to a %s\"\n                % (key, type(value).__name__))\nreturn problems",
        "doc": "Structural check on a normalised alert. A mapping that produces a malformed alert fails at ingest, where it is a configuration problem, rather than three steps into a playbook at 03:00.",
        "form": "statements",
        "language": "python",
        "name": "check_csem_shape",
        "packages": [],
        "params": [
          {
            "name": "alert",
            "type": "Map<string, Any>"
          }
        ],
        "returns": "List<string>"
