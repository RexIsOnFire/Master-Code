      "props": {
        "doc": "Supply-chain check. An unsigned manifest installs only with an explicit, audited override, and never at trusted level.",
        "isAsync": false,
        "name": "verify_manifest",
        "params": [
          {
            "name": "manifest",
            "type": "Map<string, Any>"
