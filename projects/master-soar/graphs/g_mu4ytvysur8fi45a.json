    {
      "id": "n_mu4ytvysvah58fqs",
      "inputs": [
        {
          "direction": "in",
          "id": "in",
          "name": "",
          "type": "Exec"
        },
        {
          "direction": "in",
          "id": "p:manifest",
          "name": "manifest",
          "type": "Map<string, Any>"
        }
      ],
      "outputs": [
        {
          "direction": "out",
          "id": "out",
          "name": "",
