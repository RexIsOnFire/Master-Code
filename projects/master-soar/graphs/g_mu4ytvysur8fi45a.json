        "code": "return {\n    \"type\": \"object\",\n    \"required\": [\"id\", \"name\", \"vendor\", \"version\", \"auth\", \"base_url\",\n                 \"egress_allowlist\", \"commands\"],\n    \"properties\": {\n        \"id\": {\"type\": \"string\", \"pattern\": \"^[a-z0-9_]+\\\\.[a-z0-9_]+$\"},\n        \"name\": {\"type\": \"string\"},\n        \"vendor\": {\"type\": \"string\"},\n        \"category\": {\"enum\": [\"edr\", \"siem\", \"identity\", \"ticketing\", \"email\",\n                              \"network\", \"threat_intel\", \"cloud\", \"other\"]},\n        \"version\": {\"type\": \"string\"},\n        \"auth\": {\"type\": \"object\", \"required\": [\"kind\", \"roles\"]},\n        \"base_url\": {\"type\": \"string\"},\n        \"egress_allowlist\": {\"type\": \"array\", \"items\": {\"type\": \"string\"},\n                             \"minItems\": 1},\n        \"min_vendor_permissions\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n        \"rate_limit\": {\"type\": \"object\"},\n        \"health_check\": {\"type\": \"object\"},\n        \"commands\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}},\n        \"publisher\": {\"type\": \"string\"},\n        \"signature\": {\"type\": \"string\"},\n    },\n}",
