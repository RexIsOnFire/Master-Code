        }
      ],
      "props": {
        "capabilities": [],
        "code": "from soar.commands.registry import validate_definition\n\nimport jsonschema\n\nproblems = []\ntry:\n    jsonschema.validate(manifest, connector_manifest_schema())\nexcept jsonschema.ValidationError as error:\n    return [\"manifest: \" + error.message]\n\nfor host in manifest[\"egress_allowlist\"]:\n    if host in (\"*\", \"0.0.0.0/0\") or host.startswith(\"*.\"):\n        problems.append(\n            \"egress_allowlist must name hosts; %r would permit anything\" % host\n        )\n\nfor spec in manifest[\"commands\"]:\n    problems.extend(\n        \"command %s: %s\" % (spec.get(\"key\"), p)\n        for p in validate_definition({**spec, \"trust_level\": \"trusted\",\n                                      \"auth\": [{\"role\": \"r\", \"credential\": \"c\"}]})\n    )\n\n# A first-party manifest is the same artifact as the engine reading it:\n# it ships inside this image, and a signature would be the platform\n# attesting to itself. The check exists for connectors from anywhere else,\n# which is where a supply chain actually is.\nif manifest.get(\"publisher\") != \"master-soar\" and not manifest.get(\"signature\"):\n    problems.append(\n        \"manifest is unsigned and not first-party; install only with an \"\n        \"explicit override, and it cannot be granted trusted level\"\n    )\nreturn problems",
        "doc": "Supply-chain check. An unsigned manifest installs only with an explicit, audited override, and never at trusted level.",
        "form": "statements",
        "language": "python",
        "name": "check_manifest_trust",
        "packages": [
          {
            "name": "jsonschema",
            "version": "4.*"
          }
        ],
        "params": [
          {
            "name": "manifest",
            "type": "Map<string, Any>"
          }
        ],
        "returns": "List<string>"
      },
      "type": "custom/code",
      "x": 250,
      "y": 260
