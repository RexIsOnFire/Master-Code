      "props": {
        "capabilities": [],
        "code": "from soar.audit.log import record as audit_record\nfrom soar.commands.registry import publish_version\nfrom soar.identity.rbac import require_permission\nfrom soar.platform.ids import new_id\n\nimport json\n\nrequire_permission(principal, \"integrations.manage\")\norg_id = principal[\"org_id\"]\n\nproblems = verify_manifest(manifest)\nif problems:\n    raise ValueError(\"; \".join(problems))\n\ncredential_rows = db.query(\n    \"SELECT id FROM credential WHERE org_id = %s AND name = %s\",\n    [org_id, credential_name], org_id,\n)\nif not credential_rows:\n    raise KeyError(\n        \"no credential named %r; create it before installing the connector\"\n        % credential_name\n    )\n\nintegration_id = new_id(\"intg\")\ndb.execute(\n    \"INSERT INTO integration (id, org_id, connector_id, connector_version, name, \"\n    \"config, credential_id, worker_pool, egress_allowlist) \"\n    \"VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)\",\n    [\n        integration_id, org_id, manifest[\"id\"], manifest[\"version\"],\n        config.get(\"name\", manifest[\"id\"]), json.dumps(config),\n        credential_rows[0][\"id\"], config.get(\"worker_pool\", \"default\"),\n        manifest[\"egress_allowlist\"],\n    ],\n    org_id,\n)\n\nfor spec in manifest[\"commands\"]:\n    definition = dict(spec)\n    definition[\"auth\"] = [\n        {\"role\": role, \"credential\": credential_name}\n        for role in manifest[\"auth\"][\"roles\"]\n    ]\n    # Which credential to lease is one question; where the vendor wants it\n    # put is another, and it is answered by the connector rather than by\n    # engine code that knows a list of vendors.\n    definition[\"implementation\"] = dict(definition.get(\"implementation\") or {})\n    definition[\"implementation\"][\"auth_scheme\"] = manifest[\"auth\"]\n    command_id = new_id(\"cmd\")\n    db.execute(\n        \"INSERT INTO command (id, org_id, key, name, category, integration_id, \"\n        \"trust_level, created_by) VALUES (%s, %s, %s, %s, %s, %s, 'trusted', %s)\",\n        [command_id, org_id, definition[\"key\"], definition[\"name\"],\n         definition.get(\"category\"), integration_id, principal.get(\"id\")],\n        org_id,\n    )\n    publish_version(db, principal, command_id, definition)\n\naudit_record(db, {\n    \"org_id\": org_id, \"actor_kind\": \"user\", \"actor_id\": principal.get(\"id\"),\n    \"action\": \"integration.install\", \"target_kind\": \"integration\",\n    \"target_id\": integration_id,\n    \"after\": {\"connector\": manifest[\"id\"], \"version\": manifest[\"version\"],\n              \"commands\": len(manifest[\"commands\"])},\n    \"result\": \"success\",\n})\nreturn integration_id",
        "doc": "Install a connector: register the integration and publish its commands.\n\nAdding a vendor touches no engine code. That is the test of a connector\nframework, and it is the reason this function exists rather than a module\nper vendor with its own execution path.",
