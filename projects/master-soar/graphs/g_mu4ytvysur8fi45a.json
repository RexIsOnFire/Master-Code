      "props": {
        "capabilities": [],
        "code": "from soar.commands.registry import publish_version\nfrom soar.platform.ids import new_id\n\norg_id = principal[\"org_id\"]\ncredential_name = \"%s:%s\" % (manifest[\"id\"], org_id[-8:])\npublished = 0\n\nfor spec in manifest[\"commands\"]:\n    definition = dict(spec)\n    definition[\"auth\"] = [\n        {\"role\": role, \"credential\": \"%s/%s\" % (credential_name, role)}\n        for role in manifest[\"auth\"][\"roles\"]\n    ]\n    # Which credential to lease is one question; where the vendor wants\n    # it put is another. This is the path the console uses, so a command\n    # published without it is a command that reaches the vendor with no\n    # Authorization header at all.\n    definition[\"implementation\"] = dict(definition.get(\"implementation\") or {})\n    definition[\"implementation\"][\"auth_scheme\"] = manifest[\"auth\"]\n\n    existing = db.query(\n        \"SELECT id FROM command WHERE org_id = %s AND key = %s\",\n        [org_id, definition[\"key\"]], org_id)\n    if existing:\n        command_id = existing[0][\"id\"]\n    else:\n        command_id = new_id(\"cmd\")\n        db.execute(\n            \"INSERT INTO command (id, org_id, key, name, category, \"\n            \"integration_id, trust_level, created_by) \"\n            \"VALUES (%s,%s,%s,%s,%s,%s,'trusted',%s)\",\n            [command_id, org_id, definition[\"key\"], definition[\"name\"],\n             definition.get(\"category\"), integration_id,\n             principal.get(\"id\")],\n            org_id)\n    publish_version(db, principal, command_id, definition)\n    published += 1\n\nreturn published",
        "doc": "Publish a connector's commands against an integration that already exists.\n\nThe half of install() that runs when a pending connector becomes live. Kept\nseparate because onboarding records the tool first and receives the key\nlater - the integration row is the same row throughout, so the client's\nhistory does not restart the day someone finally sends the credential.",
