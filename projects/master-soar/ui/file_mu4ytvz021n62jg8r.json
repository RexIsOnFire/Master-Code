  "rules": [
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line)",
        "margin-bottom": "12px",
        "padding": "14px 16px"
      },
      "selector": ".step"
    },
    {
      "declarations": {
        "align-items": "baseline",
        "display": "flex",
        "gap": "10px",
        "margin-bottom": "10px"
      },
      "selector": ".step-head"
    },
    {
      "declarations": {
        "border": "1px solid var(--accent)",
        "color": "var(--accent)",
        "font-family": "var(--mono)",
        "font-size": "12px",
        "padding": "1px 7px"
      },
      "selector": ".step-n"
    },
    {
      "declarations": {
        "font-size": "14px",
        "font-weight": "600",
        "margin": "0"
      },
      "selector": ".step-title"
    },
    {
      "declarations": {
        "border-top": "1px solid var(--line)",
        "margin-top": "26px",
        "padding-top": "18px"
      },
      "selector": ".end-of-life"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "11px",
        "letter-spacing": "0.08em",
        "margin": "0 0 10px",
        "text-transform": "uppercase"
      },
      "selector": ".end-of-life h2"
    },
    {
      "declarations": {
        "align-items": "center",
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "10px",
        "margin-bottom": "8px"
      },
      "selector": ".eol-row"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "11.5px",
        "line-height": "1.65",
        "margin": "0 0 14px",
        "max-width": "760px"
      },
      "selector": ".eol-note"
    },
    {
      "declarations": {
        "border-color": "var(--crit)",
        "color": "var(--crit)"
      },
      "selector": ".eol-danger"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "12px",
        "min-width": "260px",
        "padding": "5px 8px"
      },
      "selector": ".eol-confirm"
    },
    {
      "declarations": {
        "align-items": "center",
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "10px",
        "margin-bottom": "8px"
      },
      "selector": ".field"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "12px",
        "min-width": "170px"
      },
      "selector": ".field label"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "12px",
        "min-width": "260px",
        "padding": "5px 7px"
      },
      "selector": ".field input, .field select"
    },
    {
      "declarations": {
        "align-items": "center",
        "border-bottom": "1px solid var(--line)",
        "display": "flex",
        "gap": "10px",
        "padding": "6px 0"
      },
      "selector": ".tool-row"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)",
        "font-size": "11px",
        "min-width": "90px"
      },
      "selector": ".tool-cat"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "11.5px",
        "line-height": "1.5",
        "margin-bottom": "10px"
      },
      "selector": ".hint"
