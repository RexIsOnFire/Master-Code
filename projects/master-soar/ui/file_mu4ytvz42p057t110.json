{
  "breakpoints": [
    {
      "maxWidth": 640,
      "name": "mobile"
    },
    {
      "maxWidth": 1024,
      "minWidth": 641,
      "name": "tablet"
    },
    {
      "minWidth": 1025,
      "name": "desktop"
    }
  ],
  "lang": "en",
  "meta": {
    "viewport": "width=device-width, initial-scale=1"
  },
  "root": [
    {
      "children": [
        {
          "children": [
            {
              "classes": [
                "mono"
              ],
              "id": "pb-name",
              "kind": "label",
              "name": "playbookName",
              "text": "Loading…"
            },
            {
              "classes": [
                "pb-state"
              ],
              "id": "pb-state",
              "kind": "label",
              "name": "playbookState",
              "text": "DRAFT"
            },
            {
              "children": [],
              "classes": [
                "grow"
              ],
              "id": "pb-grow",
              "kind": "panel"
            },
            {
              "classes": [
                "muted",
                "tiny"
              ],
              "id": "pb-dirty",
              "kind": "label",
              "name": "dirtyFlag",
              "text": ""
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [
                "ghost"
              ],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorUndo"
                }
              ],
              "id": "pb-undo",
              "kind": "button",
              "name": "pbUndo",
              "text": "Undo"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [
                "ghost"
              ],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorRedo"
                }
              ],
              "id": "pb-redo",
              "kind": "button",
              "name": "pbRedo",
              "text": "Redo"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [
                "ghost"
              ],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorLayout"
                }
              ],
              "id": "pb-layout",
              "kind": "button",
              "name": "pbLayout",
              "text": "Auto-layout"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorSave"
                }
              ],
              "id": "pb-save",
              "kind": "button",
              "name": "pbSave",
              "text": "Save draft"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorValidate"
                }
              ],
              "id": "pb-validate",
              "kind": "button",
              "name": "pbValidate",
              "text": "Validate"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorDryRun"
                }
              ],
              "id": "pb-dryrun",
              "kind": "button",
              "name": "pbDryrun",
              "text": "Dry run"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorSimulate"
                }
              ],
              "id": "pb-simulate",
              "kind": "button",
              "name": "pbSimulate",
              "text": "Simulate"
            },
            {
              "attrs": {
                "type": "button"
              },
              "classes": [
                "accent"
              ],
              "events": [
                {
                  "event": "click",
                  "handler": "onEditorPublish"
                }
              ],
              "id": "pb-publish",
              "kind": "button",
              "name": "pbPublish",
              "text": "Publish"
            }
          ],
          "classes": [
            "pb-toolbar"
          ],
          "id": "pb-toolbar",
          "kind": "panel"
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "classes": [],
                      "id": "pb-palette-title",
                      "kind": "label",
                      "text": "Nodes"
                    }
                  ],
                  "classes": [
                    "pb-col-head"
                  ],
                  "id": "pb-palette-head",
                  "kind": "panel"
                },
                {
                  "children": [
                    {
                      "attrs": {
                        "placeholder": "Search 130+ commands…",
                        "type": "search"
                      },
                      "classes": [
                        "pb-search"
                      ],
                      "events": [
                        {
                          "event": "input",
                          "handler": "onPaletteSearch"
                        }
                      ],
                      "id": "pb-search",
                      "kind": "textbox",
                      "name": "paletteSearch"
                    },
                    {
                      "children": [],
                      "id": "pb-palette",
                      "kind": "container",
                      "name": "paletteList"
                    }
                  ],
                  "classes": [
                    "pb-col-body"
                  ],
                  "id": "pb-palette-body",
                  "kind": "panel"
                }
              ],
              "classes": [
                "pb-col"
              ],
              "id": "pb-palette-col",
              "kind": "panel"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "classes": [],
                      "id": "pb-canvas-title",
                      "kind": "label",
                      "text": "Canvas"
                    },
                    {
                      "classes": [
                        "muted"
                      ],
                      "id": "pb-canvas-hint",
                      "kind": "label",
                      "text": "drag to connect · double-click to open · F to frame · ⌘Z undo · Del remove"
                    }
                  ],
                  "classes": [
                    "pb-col-head"
                  ],
                  "id": "pb-canvas-head",
                  "kind": "panel"
                },
                {
                  "children": [],
                  "id": "pb-canvas",
                  "kind": "container",
                  "name": "editorCanvas"
                }
              ],
              "classes": [
                "pb-col"
              ],
              "id": "pb-canvas-col",
              "kind": "panel"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "classes": [],
                      "id": "pb-inspector-title",
                      "kind": "label",
                      "text": "Inspector"
                    }
                  ],
                  "classes": [
                    "pb-col-head"
                  ],
                  "id": "pb-inspector-head",
                  "kind": "panel"
                },
                {
                  "children": [
                    {
                      "children": [],
                      "id": "pb-inspector",
                      "kind": "container",
                      "name": "inspector"
                    },
                    {
                      "children": [
                        {
                          "classes": [
                            "pb-group-name"
                          ],
                          "id": "pb-problems-title",
                          "kind": "label",
                          "text": "Validation"
                        },
                        {
                          "children": [],
                          "id": "pb-problems",
                          "kind": "container",
                          "name": "problemList"
                        }
                      ],
                      "classes": [
                        "pb-section"
                      ],
                      "id": "pb-problems-section",
                      "kind": "panel"
                    }
                  ],
                  "classes": [
                    "pb-col-body"
                  ],
                  "id": "pb-inspector-body",
                  "kind": "panel"
                }
              ],
              "classes": [
                "pb-col"
              ],
              "id": "pb-inspector-col",
              "kind": "panel"
            }
          ],
          "classes": [
            "pb-shell"
          ],
          "id": "pb-shell",
          "kind": "panel"
        }
      ],
      "classes": [
        "view"
      ],
      "id": "editor-root",
      "kind": "panel"
    }
  ],
  "rules": [
    {
      "comment": "Three columns: palette, canvas, inspector. The canvas gets whatever is left.",
      "declarations": {
        "display": "grid",
        "gap": "10px",
        "grid-template-columns": "244px minmax(0, 1fr) 330px",
        "height": "calc(100vh - 150px)",
        "min-height": "520px"
      },
      "selector": ".pb-shell"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line)",
        "display": "flex",
        "flex-direction": "column",
        "min-height": "0"
      },
      "selector": ".pb-col"
    },
    {
      "declarations": {
        "align-items": "center",
        "border-bottom": "1px solid var(--line)",
        "color": "var(--muted)",
        "display": "flex",
        "font-family": "var(--mono)",
        "font-size": "10.5px",
        "gap": "8px",
        "letter-spacing": "0.14em",
        "padding": "8px 10px",
        "text-transform": "uppercase"
      },
      "selector": ".pb-col-head"
    },
    {
      "declarations": {
        "flex": "1",
        "overflow": "auto",
        "padding": "8px"
      },
      "selector": ".pb-col-body"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "11.5px",
        "margin-bottom": "8px",
        "padding": "5px 7px",
        "width": "100%"
      },
      "selector": ".pb-search"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "display": "block",
        "font-family": "var(--mono)",
        "font-size": "10px",
        "letter-spacing": "0.14em",
        "margin": "10px 0 4px",
        "text-transform": "uppercase"
      },
      "selector": ".pb-group-name"
    },
    {
      "declarations": {
        "align-items": "center",
        "background": "var(--surface-2)",
        "border": "1px solid var(--line)",
        "cursor": "grab",
        "display": "flex",
        "font-size": "11.5px",
        "gap": "7px",
        "margin-bottom": "3px",
        "padding": "5px 7px",
        "user-select": "none"
      },
      "selector": ".pb-item"
    },
    {
      "declarations": {
        "border-color": "var(--accent)"
      },
      "selector": ".pb-item:hover"
    },
    {
      "comment": "Shown, not hidden. An engineer who cannot find Isolate Host assumes the platform cannot do it.",
      "declarations": {
        "border-style": "dashed",
        "cursor": "not-allowed",
        "opacity": "0.45"
      },
      "selector": ".pb-item[data-available=\"false\"]"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)"
      },
      "selector": ".pb-item-icon"
    },
    {
      "declarations": {
        "flex": "1",
        "min-width": "0"
      },
      "selector": ".pb-item-label"
    },
    {
      "declarations": {
        "border": "1px solid currentColor",
        "font-family": "var(--mono)",
        "font-size": "9px",
        "padding": "0 4px"
      },
      "selector": ".pb-item-risk"
    },
    {
      "declarations": {
        "color": "var(--crit)"
      },
      "selector": ".pb-item-risk[data-risk=\"high\"]"
    },
    {
      "declarations": {
        "color": "var(--amber)"
      },
      "selector": ".pb-item-risk[data-risk=\"medium\"]"
    },
    {
      "declarations": {
        "background": "radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 22px 22px, var(--sunken)",
        "cursor": "grab",
        "flex": "1",
        "outline": "none",
        "overflow": "hidden",
        "position": "relative"
      },
      "selector": ".pb-canvas"
    },
    {
      "declarations": {
        "box-shadow": "inset 0 0 0 2px var(--accent)"
      },
      "selector": ".pb-canvas:focus-visible"
    },
    {
      "declarations": {
        "inset": "0",
        "position": "absolute",
        "transform-origin": "0 0"
      },
      "selector": ".pb-viewport"
    },
    {
      "declarations": {
        "color": "var(--line-strong)",
        "inset": "0",
        "overflow": "visible",
        "position": "absolute"
      },
      "selector": ".pb-wires"
    },
    {
      "declarations": {
        "inset": "0",
        "position": "absolute"
      },
      "selector": ".pb-nodes"
    },
    {
      "declarations": {
        "cursor": "pointer",
        "fill": "none",
        "stroke": "var(--line-strong)",
        "stroke-width": "1.6"
      },
      "selector": ".pb-wire"
    },
    {
      "declarations": {
        "stroke": "var(--accent)",
        "stroke-width": "2.4"
      },
      "selector": ".pb-wire:hover"
    },
    {
      "declarations": {
        "stroke": "var(--accent)",
        "stroke-dasharray": "5 4"
      },
      "selector": ".pb-wire.is-pending"
    },
    {
      "comment": "Error and unsupported branches are the ones reviewers skip, so they are the ones that look different.",
      "declarations": {
        "stroke": "var(--crit)",
        "stroke-dasharray": "6 3"
      },
      "selector": ".pb-wire.port-on_error"
    },
    {
      "declarations": {
        "stroke": "var(--amber)",
        "stroke-dasharray": "2 3"
      },
      "selector": ".pb-wire.port-on_unsupported"
    },
    {
      "declarations": {
        "stroke": "var(--crit)"
      },
      "selector": ".pb-wire.port-on_reject"
    },
    {
      "declarations": {
        "stroke": "var(--amber)"
      },
      "selector": ".pb-wire.port-on_timeout"
    },
    {
      "declarations": {
        "stroke": "var(--muted)"
      },
      "selector": ".pb-wire.port-else"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line-strong)",
        "border-left": "3px solid var(--line-strong)",
        "box-shadow": "0 1px 0 rgba(0,0,0,0.25)",
        "cursor": "grab",
        "font-size": "11.5px",
        "padding-bottom": "6px",
        "position": "absolute",
        "width": "230px"
      },
      "selector": ".pb-node"
    },
    {
      "declarations": {
        "outline": "2px solid var(--accent)",
        "outline-offset": "2px"
      },
      "selector": ".pb-node:focus-visible"
    },
    {
      "declarations": {
        "border-color": "var(--accent)",
        "box-shadow": "0 0 0 1px var(--accent)"
      },
      "selector": ".pb-node.is-selected"
    },
    {
      "declarations": {
        "border-left-color": "var(--muted)"
      },
      "selector": ".pb-node[data-accent=\"flow\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--accent)"
      },
      "selector": ".pb-node[data-accent=\"logic\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--ok)"
      },
      "selector": ".pb-node[data-accent=\"action\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--crit)"
      },
      "selector": ".pb-node[data-accent=\"danger\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--magenta)"
      },
      "selector": ".pb-node[data-accent=\"ai\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--amber)"
      },
      "selector": ".pb-node[data-accent=\"approval\"]"
    },
    {
      "declarations": {
        "border-left-color": "var(--line-strong)"
      },
      "selector": ".pb-node[data-accent=\"data\"]"
    },
    {
      "declarations": {
        "border-color": "var(--crit)"
      },
      "selector": ".pb-node[data-problem=\"error\"]"
    },
    {
      "declarations": {
        "border-color": "var(--amber)"
      },
      "selector": ".pb-node[data-problem=\"warning\"]"
    },
    {
      "declarations": {
        "align-items": "center",
        "background": "var(--surface-2)",
        "border-bottom": "1px solid var(--line)",
        "display": "flex",
        "gap": "6px",
        "padding": "5px 8px"
      },
      "selector": ".pb-node header"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)"
      },
      "selector": ".pb-icon"
    },
    {
      "declarations": {
        "flex": "1",
        "font-weight": "600",
        "min-width": "0",
        "overflow": "hidden",
        "text-overflow": "ellipsis",
        "white-space": "nowrap"
      },
      "selector": ".pb-title"
    },
    {
      "declarations": {
        "border": "1px solid currentColor",
        "font-family": "var(--mono)",
        "font-size": "8.5px",
        "letter-spacing": "0.06em",
        "padding": "1px 4px"
      },
      "selector": ".pb-badge"
    },
    {
      "declarations": {
        "color": "var(--crit)"
      },
      "selector": ".pb-badge.risk-high"
    },
    {
      "declarations": {
        "color": "var(--amber)"
      },
      "selector": ".pb-badge.risk-medium"
    },
    {
      "declarations": {
        "color": "var(--muted)"
      },
      "selector": ".pb-badge.risk-low"
    },
    {
      "declarations": {
        "color": "var(--amber)"
      },
      "selector": ".pb-badge.approval"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)",
        "font-size": "10.5px",
        "padding": "6px 8px",
        "word-break": "break-word"
      },
      "selector": ".pb-body"
    },
    {
      "declarations": {
        "border-top": "1px dotted var(--line)",
        "font-family": "var(--mono)",
        "font-size": "9.5px",
        "padding": "3px 8px"
      },
      "selector": ".pb-coverage"
    },
    {
      "declarations": {
        "color": "var(--ok)"
      },
      "selector": ".pb-coverage[data-level=\"full\"]"
    },
    {
      "declarations": {
        "color": "var(--amber)"
      },
      "selector": ".pb-coverage[data-level=\"partial\"]"
    },
    {
      "declarations": {
        "color": "var(--crit)"
      },
      "selector": ".pb-coverage[data-level=\"none\"]"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)",
        "font-size": "9.5px",
        "padding": "0 8px 4px"
      },
      "selector": ".pb-meta"
    },
    {
      "declarations": {
        "align-items": "flex-start",
        "display": "flex",
        "flex-direction": "column",
        "gap": "3px",
        "left": "100%",
        "padding": "0 0 0 6px",
        "position": "absolute",
        "top": "30px"
      },
      "selector": ".pb-ports"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line-strong)",
        "border-radius": "0",
        "box-shadow": "0 0 0 2px var(--bg)",
        "color": "var(--muted)",
        "cursor": "crosshair",
        "font-family": "var(--mono)",
        "font-size": "9px",
        "padding": "1px 6px",
        "white-space": "nowrap"
      },
      "selector": ".pb-port"
    },
    {
      "declarations": {
        "border-color": "var(--accent)",
        "color": "var(--accent)"
      },
      "selector": ".pb-port:hover"
    },
    {
      "declarations": {
        "border-color": "var(--crit)",
        "color": "var(--crit)"
      },
      "selector": ".pb-port[data-port=\"on_error\"]:hover"
    },
    {
      "declarations": {
        "background": "var(--line-strong)",
        "border": "1px solid var(--surface)",
        "height": "9px",
        "left": "-5px",
        "position": "absolute",
        "top": "22px",
        "width": "9px"
      },
      "selector": ".pb-inlet"
    },
    {
      "declarations": {
        "margin-bottom": "9px"
      },
      "selector": ".pb-field"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "display": "block",
        "font-family": "var(--mono)",
        "font-size": "10px",
        "letter-spacing": "0.08em",
        "margin-bottom": "2px",
        "text-transform": "uppercase"
      },
      "selector": ".pb-field label"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "11.5px",
        "padding": "5px 6px",
        "width": "100%"
      },
      "selector": ".pb-field input, .pb-field select, .pb-field textarea"
    },
    {
      "declarations": {
        "min-height": "70px",
        "resize": "vertical"
      },
      "selector": ".pb-field textarea"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "10.5px",
        "letter-spacing": "0",
        "margin-top": "2px",
        "text-transform": "none"
      },
      "selector": ".pb-field .pb-hint"
    },
    {
      "declarations": {
        "color": "var(--crit)",
        "content": "\" *\""
      },
      "selector": ".pb-field[data-required=\"true\"] label::after"
    },
    {
      "declarations": {
        "background": "transparent",
        "border": "1px solid var(--line-strong)",
        "color": "var(--accent)",
        "cursor": "pointer",
        "font-family": "var(--mono)",
        "font-size": "9.5px",
        "margin-left": "4px",
        "padding": "1px 5px"
      },
      "selector": ".pb-varbtn"
    },
    {
      "declarations": {
        "border-top": "1px solid var(--line)",
        "margin-top": "10px",
        "padding-top": "8px"
      },
      "selector": ".pb-section"
    },
    {
      "declarations": {
        "border-left": "2px solid var(--amber)",
        "color": "var(--muted)",
        "font-size": "10.5px",
        "margin": "5px 0",
        "padding": "3px 7px"
      },
      "selector": ".pb-vendor-note"
    },
    {
      "declarations": {
        "border-left": "2px solid var(--line-strong)",
        "cursor": "pointer",
        "display": "block",
        "font-size": "11px",
        "margin-bottom": "3px",
        "padding": "4px 7px"
      },
      "selector": ".pb-problem"
    },
    {
