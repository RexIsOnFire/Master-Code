{
  "breakpoints": [
    {
      "maxWidth": 640,
      "name": "mobile"
    },
    {
      "maxWidth": 1024,
      "minWidth": 641,
      "name": "tablet"
    },
    {
      "minWidth": 1025,
      "name": "desktop"
    }
  ],
  "lang": "en",
  "meta": {
    "viewport": "width=device-width, initial-scale=1"
  },
  "root": [
    {
      "children": [
        {
          "children": [
            {
              "children": [
                {
                  "classes": [
                    "brand-mark"
                  ],
                  "id": "login-mark",
                  "kind": "label",
                  "text": "//"
                },
                {
                  "classes": [
                    "brand-name"
                  ],
                  "id": "login-name",
                  "kind": "label",
                  "text": "MASTER SOAR"
                }
              ],
              "classes": [
                "brand"
              ],
              "id": "login-brand",
              "kind": "panel"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "attrs": {
                        "for": "login-email"
                      },
                      "id": "email-label",
                      "kind": "label",
                      "text": "Email"
                    },
                    {
                      "attrs": {
                        "autocomplete": "username",
                        "required": "required",
                        "type": "email"
                      },
                      "id": "login-email",
                      "kind": "textbox",
                      "name": "loginEmail"
                    }
                  ],
                  "classes": [
                    "pb-field"
                  ],
                  "id": "field-email",
                  "kind": "panel"
                },
                {
                  "children": [
                    {
                      "attrs": {
                        "for": "login-password"
                      },
                      "id": "password-label",
                      "kind": "label",
                      "text": "Password"
                    },
                    {
                      "attrs": {
                        "autocomplete": "current-password",
                        "required": "required",
                        "type": "password"
                      },
                      "id": "login-password",
                      "kind": "textbox",
                      "name": "loginPassword"
                    }
                  ],
                  "classes": [
                    "pb-field"
                  ],
                  "id": "field-password",
                  "kind": "panel"
                },
                {
                  "attrs": {
                    "type": "button"
                  },
                  "classes": [
                    "accent",
                    "wide"
                  ],
                  "events": [
                    {
                      "event": "click",
                      "handler": "onLoginPassword"
                    }
                  ],
                  "id": "login-submit",
                  "kind": "button",
                  "name": "loginSubmit",
                  "text": "Continue"
                }
              ],
              "id": "login-form",
              "kind": "form",
              "name": "loginForm"
            },
            {
              "children": [
                {
                  "classes": [
                    "field-label"
                  ],
                  "id": "enrol-title",
                  "kind": "label",
                  "text": "SET UP YOUR AUTHENTICATOR"
                },
                {
                  "classes": [
                    "enrol-hint"
                  ],
                  "id": "enrol-hint",
                  "kind": "label",
                  "text": "Scan this with Microsoft Authenticator: + > Other account > scan. Then enter the six digits it shows."
                },
                {
                  "children": [],
                  "classes": [
                    "enrol-qr"
                  ],
                  "id": "enrol-qr",
                  "kind": "panel",
                  "name": "enrolQr"
                },
                {
                  "classes": [
                    "enrol-secret"
                  ],
                  "id": "enrol-secret",
                  "kind": "label",
                  "name": "enrolSecret",
                  "text": ""
                }
              ],
              "classes": [
                "enrol-step"
              ],
              "id": "enrol-step",
              "kind": "panel"
            },
            {
              "children": [
                {
                  "classes": [
                    "card-title"
                  ],
                  "id": "mfa-title",
                  "kind": "label",
                  "text": "Two-factor code"
                },
                {
                  "attrs": {
                    "autocomplete": "one-time-code",
                    "inputmode": "numeric",
                    "maxlength": "6",
                    "placeholder": "000000"
                  },
                  "id": "login-code",
                  "kind": "textbox",
                  "name": "loginCode"
                },
                {
                  "attrs": {
                    "type": "button"
                  },
                  "classes": [
                    "accent",
                    "wide"
                  ],
                  "events": [
                    {
                      "event": "click",
                      "handler": "onLoginMfa"
                    }
                  ],
                  "id": "mfa-submit",
                  "kind": "button",
                  "name": "mfaSubmit",
                  "text": "Sign in"
                }
              ],
              "classes": [
                "mfa-step"
              ],
              "id": "mfa-step",
              "kind": "panel"
            },
            {
              "classes": [
                "login-error"
              ],
              "id": "login-error",
              "kind": "label",
              "name": "loginError",
              "text": ""
            },
            {
              "classes": [
                "muted",
                "tiny"
              ],
              "id": "login-note",
              "kind": "label",
              "text": "A password alone gets you a session with no permissions. MFA is what grants them."
            }
          ],
          "classes": [
            "login-card"
          ],
          "id": "login-card",
          "kind": "panel"
        }
      ],
      "classes": [
        "login-wrap"
      ],
      "id": "login-wrap",
      "kind": "panel"
    }
  ],
  "rules": [
    {
      "declarations": {
        "display": "grid",
        "min-height": "100vh",
        "padding": "16px",
        "place-items": "center"
      },
      "selector": ".login-wrap"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line)",
        "padding": "22px",
        "width": "min(360px, 100%)"
      },
      "selector": ".login-card"
    },
    {
      "declarations": {
        "border": "0",
        "padding": "0 0 14px"
      },
      "selector": ".login-card .brand"
    },
    {
      "comment": "Hidden until the password step succeeds; the two steps are never on screen together.",
      "declarations": {
        "display": "none",
        "margin-top": "14px"
      },
      "selector": ".mfa-step"
    },
    {
      "declarations": {
        "display": "block"
      },
      "selector": ".mfa-step.is-active"
    },
    {
      "declarations": {
        "display": "none",
        "margin-bottom": "14px"
      },
      "selector": ".enrol-step"
    },
    {
      "declarations": {
        "display": "block"
      },
      "selector": ".enrol-step.is-active"
    },
    {
      "declarations": {
        "background": "#ffffff",
        "border": "1px solid var(--line)",
        "display": "inline-block",
        "margin-bottom": "8px",
        "padding": "10px"
      },
      "selector": ".enrol-qr"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "display": "block",
        "font-size": "11.5px",
        "line-height": "1.5",
        "margin-bottom": "10px"
      },
      "selector": ".enrol-hint"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "display": "block",
        "font-family": "var(--mono)",
        "font-size": "11.5px",
        "margin-bottom": "10px",
        "word-break": "break-all"
      },
      "selector": ".enrol-secret"
    },
    {
      "declarations": {
        "color": "var(--crit)",
        "display": "block",
        "font-size": "11.5px",
        "margin-top": "10px",
        "min-height": "16px"
      },
      "selector": ".login-error"
    },
    {
      "declarations": {
        "margin-bottom": "10px"
      },
      "selector": ".login-card .pb-field"
    }
  ],
  "scripts": [
    "file_mu4ytvyz21chr7736",
    "file_mu4ytvz42p1hyj04c"
  ],
  "stylesheets": [
    "file_mu4ytvyz21bnia7p5"
  ],
  "title": "Master SOAR — Sign in"
}
