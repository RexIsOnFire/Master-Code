  "rules": [
    {
      "declarations": {
        "display": "grid",
        "font-family": "var(--mono)",
        "font-size": "11.5px",
        "gap": "8px",
        "grid-template-columns": "repeat(auto-fit, minmax(140px, 1fr))",
        "margin-bottom": "12px"
      },
      "selector": ".exec-meta"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "display": "block"
      },
      "selector": ".exec-meta span"
    },
    {
      "declarations": {
        "color": "var(--ink)",
        "font-weight": "600"
      },
      "selector": ".exec-meta strong"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "font-family": "var(--mono)",
        "font-size": "11.5px",
        "max-height": "420px",
        "overflow-x": "auto",
        "padding": "10px",
        "white-space": "pre-wrap"
      },
      "selector": ".step-detail"
    }
