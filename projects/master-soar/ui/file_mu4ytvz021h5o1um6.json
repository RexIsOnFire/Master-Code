        "gap": "8px",
        "margin-bottom": "6px"
      },
      "selector": ".email-row"
    },
    {
      "declarations": {
        "display": "grid",
        "gap": "4px 14px",
        "grid-template-columns": "repeat(auto-fill, minmax(230px, 1fr))"
      },
      "selector": ".tool-grid"
    },
    {
      "declarations": {
        "align-items": "center",
        "display": "flex",
        "font-size": "12.5px",
        "gap": "7px",
        "padding": "3px 0"
      },
      "selector": ".tool-pick"
    },
    {
      "declarations": {
        "accent-color": "var(--accent)",
        "width": "auto"
      },
      "selector": ".tool-pick input"
    },
    {
      "declarations": {
        "color": "var(--accent)",
        "font-family": "var(--mono)",
        "font-size": "11px",
        "letter-spacing": "0.08em",
        "margin": "14px 0 4px"
      },
      "selector": ".cat-head"
    },
