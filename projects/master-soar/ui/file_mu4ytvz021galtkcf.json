  "rules": [
    {
      "comment": "Light mode: a paper ground for a daylit SOC, same accent hues darkened for contrast.",
      "declarations": {
        "--accent": "#00707e",
        "--accent-ink": "#ffffff",
        "--accent-soft": "#d2eef1",
        "--amber": "#8a5300",
        "--bg": "#eceef2",
        "--crit": "#a01226",
        "--grid": "rgba(13, 17, 23, 0.05)",
        "--ink": "#0d1117",
        "--ink-dim": "#48526244",
        "--line": "#c9d0dc",
        "--line-strong": "#94a0b4",
        "--magenta": "#9b1667",
        "--mono": "ui-monospace, 'JetBrains Mono', 'Cascadia Mono', 'SF Mono', Menlo, monospace",
        "--muted": "#5a6675",
        "--ok": "#1a6b3c",
        "--rail-w": "204px",
        "--sans": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "--sunken": "#e4e8ef",
        "--surface": "#ffffff",
        "--surface-2": "#f4f6fa",
        "--warn": "#8a5300",
        "color-scheme": "light"
      },
      "selector": ":root"
    },
    {
      "comment": "Dark mode: near-black with a cyan/magenta pair. Contrast is spent on data, not on chrome.",
      "declarations": {
        "--accent": "#2ff3d6",
        "--accent-ink": "#04120f",
        "--accent-soft": "#0d2b2a",
        "--amber": "#ffb03a",
        "--bg": "#07090d",
        "--crit": "#ff4d5e",
        "--grid": "rgba(47, 243, 214, 0.045)",
        "--ink": "#d7e3ef",
        "--ink-dim": "#8aa0b633",
        "--line": "#1e2936",
        "--line-strong": "#33475c",
        "--magenta": "#ff3d8b",
        "--muted": "#7286a0",
        "--ok": "#2ff3a8",
        "--sunken": "#05070a",
        "--surface": "#0c1016",
        "--surface-2": "#111823",
        "--warn": "#ffb03a",
        "color-scheme": "dark"
      },
      "media": "(prefers-color-scheme: dark)",
      "selector": ":root[data-theme=\"dark\"], :root:not([data-theme=\"light\"])"
    },
    {
      "comment": "The explicit choice wins over the system preference, in both directions.",
      "declarations": {
        "--accent": "#2ff3d6",
        "--accent-ink": "#04120f",
        "--accent-soft": "#0d2b2a",
        "--amber": "#ffb03a",
        "--bg": "#07090d",
        "--crit": "#ff4d5e",
        "--grid": "rgba(47, 243, 214, 0.045)",
        "--ink": "#d7e3ef",
        "--line": "#1e2936",
        "--line-strong": "#33475c",
        "--magenta": "#ff3d8b",
        "--muted": "#7286a0",
        "--ok": "#2ff3a8",
        "--sunken": "#05070a",
        "--surface": "#0c1016",
        "--surface-2": "#111823",
        "--warn": "#ffb03a",
        "color-scheme": "dark"
      },
      "selector": ":root[data-theme=\"dark\"]"
    },
    {
      "declarations": {
        "box-sizing": "border-box"
      },
      "selector": "*, *::before, *::after"
    },
    {
      "comment": "The faint grid is the only decoration. It reads as an instrument panel rather than a poster.",
      "declarations": {
        "-webkit-font-smoothing": "antialiased",
        "background": "linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 100% 28px, linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 28px 100%, var(--bg)",
        "color": "var(--ink)",
        "font-family": "var(--sans)",
        "font-size": "13px",
        "line-height": "1.45",
        "margin": "0"
      },
      "selector": "body"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border-right": "1px solid var(--line)",
        "display": "flex",
        "flex-direction": "column",
        "inset": "0 auto 0 0",
        "position": "fixed",
        "width": "var(--rail-w)",
        "z-index": "20"
      },
      "selector": ".rail"
    },
    {
      "declarations": {
        "align-items": "baseline",
        "border-bottom": "1px solid var(--line)",
        "display": "flex",
        "gap": "8px",
        "padding": "14px 16px 12px"
      },
      "selector": ".brand"
    },
    {
      "declarations": {
        "color": "var(--accent)",
        "font-family": "var(--mono)",
        "font-weight": "700"
      },
      "selector": ".brand-mark"
    },
    {
      "declarations": {
        "font-family": "var(--mono)",
        "font-size": "12px",
        "font-weight": "600",
        "letter-spacing": "0.14em"
      },
      "selector": ".brand-name"
    },
    {
      "declarations": {
        "display": "flex",
        "flex": "1",
        "flex-direction": "column",
        "list-style": "none",
        "margin": "0",
        "overflow": "auto",
        "padding": "8px 0"
      },
      "selector": ".nav"
    },
    {
      "declarations": {
        "border-left": "2px solid transparent",
        "color": "var(--muted)",
        "display": "block",
        "font-size": "12.5px",
        "padding": "6px 16px 6px 14px",
        "text-decoration": "none"
      },
      "selector": ".nav-item"
    },
    {
      "declarations": {
        "background": "var(--surface-2)",
        "color": "var(--ink)"
      },
      "selector": ".nav-item:hover"
    },
    {
      "declarations": {
