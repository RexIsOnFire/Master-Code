  "rules": [
    {
      "declarations": {
        "align-items": "center",
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "10px",
        "margin-bottom": "14px"
      },
      "selector": ".hunt-filters"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "12px",
        "min-width": "170px",
        "padding": "5px 8px"
      },
      "selector": ".hunt-filters select"
    },
    {
      "declarations": {
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "3px",
        "margin-bottom": "18px"
      },
      "selector": ".cover"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line)",
        "min-width": "94px",
        "padding": "6px 9px"
      },
      "selector": ".cover-cell"
    },
    {
      "declarations": {
        "border-style": "dashed",
        "opacity": "0.55"
      },
      "selector": ".cover-cell.is-empty"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "10.5px",
        "line-height": "1.3"
      },
      "selector": ".cover-tactic"
    },
    {
      "declarations": {
        "font-family": "var(--mono)",
        "font-size": "16px",
        "font-weight": "600"
      },
      "selector": ".cover-n"
    },
    {
      "declarations": {
        "background": "var(--surface)",
        "border": "1px solid var(--line)",
        "margin-bottom": "6px",
        "padding": "10px 14px"
      },
      "selector": ".hunt"
    },
    {
      "declarations": {
        "align-items": "center",
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "12px"
      },
      "selector": ".hunt-line"
    },
    {
      "declarations": {
        "font-weight": "600",
        "min-width": "260px"
      },
      "selector": ".hunt-name"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)",
        "font-size": "11px"
      },
      "selector": ".hunt-tag"
    },
    {
      "declarations": {
        "flex": "1"
      },
      "selector": ".hunt-grow"
    },
    {
      "declarations": {
        "border-top": "1px solid var(--line)",
        "margin-top": "10px",
        "padding-top": "10px"
      },
      "selector": ".hunt-form"
    },
    {
      "declarations": {
        "align-items": "flex-start",
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "10px",
        "margin-bottom": "8px"
      },
      "selector": ".hunt-field"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "11.5px",
        "min-width": "150px",
        "padding-top": "5px"
      },
      "selector": ".hunt-field label"
    },
    {
      "declarations": {
        "background": "var(--sunken)",
        "border": "1px solid var(--line)",
        "color": "var(--ink)",
        "font-family": "var(--mono)",
        "font-size": "12px",
        "min-width": "320px",
        "padding": "5px 8px"
      },
      "selector": ".hunt-field input, .hunt-field select, .hunt-field textarea"
    },
    {
      "declarations": {
        "line-height": "1.5",
        "min-height": "190px",
        "min-width": "560px"
      },
      "selector": ".hunt-field textarea"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-size": "11px",
        "line-height": "1.5",
        "margin": "2px 0 10px 160px"
      },
      "selector": ".hunt-hint"
    },
    {
      "declarations": {
        "margin-bottom": "20px"
      },
      "selector": ".client-block"
    },
    {
      "declarations": {
        "align-items": "baseline",
        "border-bottom": "1px solid var(--accent)",
        "display": "flex",
        "gap": "10px",
        "margin-bottom": "8px",
        "padding-bottom": "5px"
      },
      "selector": ".client-bar"
    },
    {
      "declarations": {
        "color": "var(--accent)",
        "font-size": "13.5px",
        "font-weight": "600"
      },
      "selector": ".client-bar .who"
    },
    {
      "declarations": {
        "color": "var(--muted)",
        "font-family": "var(--mono)",
        "font-size": "11px"
      },
      "selector": ".client-bar .tally"
    }
  ],
